@using REAL_STATE.Models.VM
@model ScheduleAppointmentVM
@{
    ViewData["Title"] = "Request a viewing";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container py-4 py-lg-5">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item">
                <a asp-controller="Properties" asp-action="Index"
                   asp-route-listingType="@Model.ListingType">Properties</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Request a viewing</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">Request a viewing</h1>
        <p class="text-secondary mb-0">
            Tell us when you'd like to visit. This sends a request; it is not a confirmed booking.
        </p>
    </div>

    <div class="row g-4">

        <!-- Property summary (shown first on mobile) -->
        <div class="col-12 col-lg-5 order-1 order-lg-2">
            <div class="card border shadow-sm">
                @if (!string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
                {
                    <img src="@Model.PrimaryImageUrl" alt="@Model.PrimaryImageAlt"
                         class="card-img-top" style="aspect-ratio:16/10; object-fit:cover;" />
                }
                <div class="card-body">
                    <h2 class="h5 mb-1 text-break">@Model.PropertyTitle</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.PropertyLocation))
                    {
                        <p class="text-secondary small mb-2 text-break">@Model.PropertyLocation</p>
                    }
                    <p class="fs-5 fw-semibold text-success mb-0">
                        ₱@Model.Price.ToString("N0")@(string.Equals(Model.ListingType, "Rent", StringComparison.OrdinalIgnoreCase) ? " / month" : "")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.AgentName))
                    {
                        <hr />
                        <p class="small text-secondary mb-0">Listing agent: <span class="text-dark">@Model.AgentName</span></p>
                    }
                </div>
            </div>
        </div>

        <!-- Form -->
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <form asp-action="Create" method="post" class="card border shadow-sm" novalidate>
                <div class="card-body p-4">
                    <input type="hidden" asp-for="PropertyId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h2 class="h6 text-uppercase text-secondary mb-3" style="letter-spacing:1px;">When</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <label asp-for="PreferredDate" class="form-label"></label>
                            <input asp-for="PreferredDate" class="form-control" min="@minDate" />
                            <span asp-validation-for="PreferredDate" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="PreferredTime" class="form-label"></label>
                            <input asp-for="PreferredTime" class="form-control" />
                            <span asp-validation-for="PreferredTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <h2 class="h6 text-uppercase text-secondary mb-3" style="letter-spacing:1px;">Your details</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="ContactName" class="form-label"></label>
                            <input asp-for="ContactName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="ContactEmail" class="form-label"></label>
                            <input asp-for="ContactEmail" type="email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="ContactPhone" class="form-label"></label>
                            <input asp-for="ContactPhone" type="tel" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" rows="3" class="form-control"
                                      placeholder="Anything the agent should know before the visit?"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <button type="submit" class="btn btn-success px-4">Send viewing request</button>
                        <a asp-controller="Properties" asp-action="Index"
                           asp-route-listingType="@Model.ListingType"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                    <p class="small text-secondary mt-3 mb-0">
                        Your request will be saved with a status of "Pending" until it is reviewed.
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}