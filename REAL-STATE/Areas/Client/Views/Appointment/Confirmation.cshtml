@{
    ViewData["Title"] = "Viewing request sent";
}

<main class="min-h-screen bg-snow px-4 py-12 text-navy">

    <div class="mx-auto w-full max-w-xl">

        <div class="rounded-lg border border-ice bg-white p-6 text-center shadow-sm sm:p-10">

            <!-- Success Icon -->
            <span class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-azure text-white"
                  aria-hidden="true">

                <i data-lucide="check" class="size-6"></i>

            </span>

            <!-- Heading -->
            <h1 class="mb-2 font-display text-2xl font-semibold text-navy sm:text-3xl">
                Viewing request received
            </h1>

            <p class="mb-6 text-sm leading-relaxed text-navy/60 sm:text-base">
                Your request is
                <strong class="font-semibold text-azure">pending</strong>.
                It has not been confirmed yet.
            </p>

            <!-- Request Details -->
            <dl class="mb-6 rounded-lg border border-ice bg-snow p-4 text-left">

                <div class="mb-4">
                    <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-navy/50">
                        Property
                    </dt>

                    <dd class="break-words text-sm font-medium text-navy">
                        @ViewData["Property"]
                    </dd>
                </div>

                <div class="mb-4">
                    <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-navy/50">
                        Requested date and time
                    </dt>

                    <dd class="text-sm font-medium text-navy">
                        @ViewData["When"]
                    </dd>
                </div>

                <div>
                    <dt class="mb-1 text-xs font-medium uppercase tracking-wide text-navy/50">
                        Contact email
                    </dt>

                    <dd class="break-words text-sm font-medium text-navy">
                        @ViewData["Email"]
                    </dd>
                </div>

            </dl>

            <!-- Actions -->
            <div class="flex flex-col justify-center gap-3 sm:flex-row">

                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="inline-flex items-center justify-center gap-2 rounded-md bg-azure px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">

                    <i data-lucide="building-2" class="size-4"></i>

                    Browse more properties
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Hero"
                    
                   class="inline-flex items-center justify-center gap-2 rounded-md border border-azure bg-white px-5 py-2.5 text-sm font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">

                    <i data-lucide="arrow-left" class="size-4"></i>

                    Back to home
                </a>

            </div>

        </div>

    </div>

</main>