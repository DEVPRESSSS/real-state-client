@{
    ViewData["Title"] = "Viewing request sent";
}

<div class="container py-5">
    <div class="mx-auto text-center bg-white border rounded p-4 p-lg-5" style="max-width:560px;">
        <span class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3"
              style="width:48px;height:48px;" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
            </svg>
        </span>

        <h1 class="h3 mb-2" style="font-family:'Playfair Display',serif;">Viewing request received</h1>
        <p class="text-secondary">
            Your request is <strong class="text-dark">pending</strong>. It has not been confirmed yet.
        </p>

        <dl class="text-start border rounded p-3 mb-4 small">
            <dt class="text-secondary fw-normal">Property</dt>
            <dd class="mb-2 text-break">@ViewData["Property"]</dd>
            <dt class="text-secondary fw-normal">Requested date and time</dt>
            <dd class="mb-2">@ViewData["When"]</dd>
            <dt class="text-secondary fw-normal">Contact email</dt>
            <dd class="mb-0 text-break">@ViewData["Email"]</dd>
        </dl>

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a asp-controller="Properties" asp-action="Index" class="btn btn-success">Browse more properties</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to home</a>
        </div>
    </div>
</div>