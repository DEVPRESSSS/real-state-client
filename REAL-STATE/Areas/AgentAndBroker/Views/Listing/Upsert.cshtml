@using REAL_STATE.Models
@using REAL_STATE.Models.VM
@model PropertyVM

<div class="container py-4 py-lg-5">
    <div class="mb-4">
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">
            @(Model.IsEdit ? "Edit property" : "List a property")
        </h1>
        <p class="text-secondary mb-0">Fields marked <span class="text-danger">*</span> are required.</p>
    </div>

    <form asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" method="post" novalidate>
        <input type="hidden" asp-for="Property.Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">

                <!-- Basic information -->
                <section class="card border shadow-sm mb-4" aria-labelledby="basic-heading">
                    <div class="card-body">
                        <h2 id="basic-heading" class="h5 mb-3">Basic information</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Property.Title" class="form-label">Title <span class="text-danger">*</span></label>
                                <input asp-for="Property.Title" class="form-control" maxlength="200"
                                       placeholder="e.g. 2-bedroom condominium near BGC" />
                                <span asp-validation-for="Property.Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Property.Slug" class="form-label">URL slug <span class="text-danger">*</span></label>
                                <input asp-for="Property.Slug" class="form-control" maxlength="250"
                                       placeholder="2-bedroom-condominium-near-bgc"
                                       aria-describedby="slugHelp" />
                                <div id="slugHelp" class="form-text">Must be unique. Use lowercase letters, numbers and hyphens.</div>
                                <span asp-validation-for="Property.Slug" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Property.PropertyType" class="form-label">Property type <span class="text-danger">*</span></label>
                                <input asp-for="Property.PropertyType" class="form-control" maxlength="50"
                                       placeholder="e.g. Condominium" />
                                <span asp-validation-for="Property.PropertyType" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Property.ListingType" class="form-label">Listing type <span class="text-danger">*</span></label>
                                <select asp-for="Property.ListingType" class="form-select">
                                    <option value="Sale">For sale</option>
                                    <option value="Rent">For rent</option>
                                </select>
                                <span asp-validation-for="Property.ListingType" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Property.Description" class="form-label">Description</label>
                                <textarea asp-for="Property.Description" class="form-control" rows="6" maxlength="8000"></textarea>
                                <span asp-validation-for="Property.Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Price and specifications -->
                <section class="card border shadow-sm mb-4" aria-labelledby="specs-heading">
                    <div class="card-body">
                        <h2 id="specs-heading" class="h5 mb-3">Price and specifications</h2>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Property.Price" class="form-label">Price <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="Property.Price" type="number" min="0" step="any" class="form-control" />
                                </div>
                                <span asp-validation-for="Property.Price" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Property.FloorAreaSqFt" class="form-label">Floor area <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Property.FloorAreaSqFt" type="number" min="0" step="any" class="form-control" />
                                    <span class="input-group-text">sq ft</span>
                                </div>
                                <span asp-validation-for="Property.FloorAreaSqFt" class="text-danger small"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="Property.Bedrooms" class="form-label">Bedrooms</label>
                                <input asp-for="Property.Bedrooms" type="number" min="0" step="1" class="form-control" />
                                <span asp-validation-for="Property.Bedrooms" class="text-danger small"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="Property.Bathrooms" class="form-label">Bathrooms</label>
                                <input asp-for="Property.Bathrooms" type="number" min="0" step="1" class="form-control" />
                                <span asp-validation-for="Property.Bathrooms" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Location -->
                <section class="card border shadow-sm mb-4" aria-labelledby="location-heading">
                    <div class="card-body">
                        <h2 id="location-heading" class="h5 mb-3">Location</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Property.Address" class="form-label">Street address</label>
                                <input asp-for="Property.Address" class="form-control" maxlength="300" />
                                <span asp-validation-for="Property.Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="Property.City" class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="Property.City" class="form-control" maxlength="100" />
                                <span asp-validation-for="Property.City" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="Property.Province" class="form-label">Province</label>
                                <input asp-for="Property.Province" class="form-control" maxlength="100" />
                                <span asp-validation-for="Property.Province" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="Property.Country" class="form-label">Country <span class="text-danger">*</span></label>
                                <input asp-for="Property.Country" class="form-control" maxlength="100" />
                                <span asp-validation-for="Property.Country" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-lg-4">
                <section class="card border shadow-sm mb-4" aria-labelledby="assign-heading">
                    <div class="card-body">
                        <h2 id="assign-heading" class="h5 mb-3">Listing details</h2>

                        <div class="mb-3">
                            <label asp-for="Property.DeveloperId" class="form-label">Developer <span class="text-danger">*</span></label>
                            <select asp-for="Property.DeveloperId" asp-items="Model.Developers" class="form-select">
                                <option value="">Select a developer</option>
                            </select>
                            <span asp-validation-for="Property.DeveloperId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Property.Status" class="form-label">Status <span class="text-danger">*</span></label>
                            <select asp-for="Property.Status" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Reserved">Reserved</option>
                                <option value="Sold">Sold</option>
                            </select>
                            <span asp-validation-for="Property.Status" class="text-danger small"></span>
                        </div>

                        <p class="small text-secondary mb-0">
                            <i class="bi bi-person-check me-1"></i>This listing is automatically assigned to you.
                        </p>
                    </div>
                </section>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Save property
                    </button>
                    <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}