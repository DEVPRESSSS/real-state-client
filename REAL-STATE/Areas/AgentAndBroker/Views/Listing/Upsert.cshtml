@using REAL_STATE.Models
@using REAL_STATE.Models.VM
@model PropertyVM
@{
    const string inputCls = "block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30";
    const string labelCls = "mb-1 block text-sm font-medium text-navy";
    const string errCls = "mt-1 block text-sm text-red-700";
    const string card = "mb-6 rounded-lg border border-ice bg-white p-6 shadow-sm";
    const string addon = "inline-flex items-center border border-ice bg-ice px-3 text-sm text-navy";
}

<div class="mb-6">
    <h1 class="mb-1 font-display text-3xl font-semibold text-navy">
        @(Model.IsEdit ? "Edit property" : "List a property")
    </h1>
    <p class="text-navy/60">Fields marked <span class="text-red-700">*</span> are required.</p>
</div>

<form asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" method="post" novalidate>
    <input type="hidden" asp-for="Property.Id" />
    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700" role="alert"></div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <div class="lg:col-span-2">

            <!-- Basic information -->
            <section class="@card" aria-labelledby="basic-heading">
                <h2 id="basic-heading" class="mb-4 font-display text-lg font-semibold text-navy">Basic information</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">

                    <div class="md:col-span-2">
                        <label asp-for="Property.Title" class="@labelCls">Title <span class="text-red-700">*</span></label>
                        <input asp-for="Property.Title" class="@inputCls" maxlength="200"
                               placeholder="e.g. 2-bedroom condominium near BGC" />
                        <span asp-validation-for="Property.Title" class="@errCls"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Property.Slug" class="@labelCls">URL slug <span class="text-red-700">*</span></label>
                        <input asp-for="Property.Slug" class="@inputCls" maxlength="250"
                               placeholder="2-bedroom-condominium-near-bgc" aria-describedby="slugHelp" />
                        <p id="slugHelp" class="mt-1 text-sm text-navy/60">Must be unique. Use lowercase letters, numbers and hyphens.</p>
                        <span asp-validation-for="Property.Slug" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.PropertyType" class="@labelCls">Property type <span class="text-red-700">*</span></label>
                        <input asp-for="Property.PropertyType" class="@inputCls" maxlength="50" placeholder="e.g. Condominium" />
                        <span asp-validation-for="Property.PropertyType" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.ListingType" class="@labelCls">Listing type <span class="text-red-700">*</span></label>
                        <select asp-for="Property.ListingType" class="@inputCls">
                            <option value="Sale">For sale</option>
                            <option value="Rent">For rent</option>
                        </select>
                        <span asp-validation-for="Property.ListingType" class="@errCls"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Property.Description" class="@labelCls">Description</label>
                        <textarea asp-for="Property.Description" class="@inputCls" rows="6" maxlength="8000"></textarea>
                        <span asp-validation-for="Property.Description" class="@errCls"></span>
                    </div>
                </div>
            </section>

            <!-- Price and specifications -->
            <section class="@card" aria-labelledby="specs-heading">
                <h2 id="specs-heading" class="mb-4 font-display text-lg font-semibold text-navy">Price and specifications</h2>
                <div class="grid grid-cols-2 gap-4">

                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="Property.Price" class="@labelCls">Price <span class="text-red-700">*</span></label>
                        <div class="flex">
                            <span class="@addon rounded-l border-r-0">₱</span>
                            <input asp-for="Property.Price" type="number" min="0" step="any" class="@inputCls rounded-l-none" />
                        </div>
                        <span asp-validation-for="Property.Price" class="@errCls"></span>
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <label asp-for="Property.FloorAreaSqFt" class="@labelCls">Floor area <span class="text-red-700">*</span></label>
                        <div class="flex">
                            <input asp-for="Property.FloorAreaSqFt" type="number" min="0" step="any" class="@inputCls rounded-r-none" />
                            <span class="@addon rounded-r border-l-0">sq ft</span>
                        </div>
                        <span asp-validation-for="Property.FloorAreaSqFt" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.Bedrooms" class="@labelCls">Bedrooms</label>
                        <input asp-for="Property.Bedrooms" type="number" min="0" step="1" class="@inputCls" />
                        <span asp-validation-for="Property.Bedrooms" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.Bathrooms" class="@labelCls">Bathrooms</label>
                        <input asp-for="Property.Bathrooms" type="number" min="0" step="1" class="@inputCls" />
                        <span asp-validation-for="Property.Bathrooms" class="@errCls"></span>
                    </div>
                </div>
            </section>

            <!-- Location -->
            <section class="@card" aria-labelledby="location-heading">
                <h2 id="location-heading" class="mb-4 font-display text-lg font-semibold text-navy">Location</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                    <div class="md:col-span-3">
                        <label asp-for="Property.Address" class="@labelCls">Street address</label>
                        <input asp-for="Property.Address" class="@inputCls" maxlength="300" />
                        <span asp-validation-for="Property.Address" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.City" class="@labelCls">City <span class="text-red-700">*</span></label>
                        <input asp-for="Property.City" class="@inputCls" maxlength="100" />
                        <span asp-validation-for="Property.City" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.Province" class="@labelCls">Province</label>
                        <input asp-for="Property.Province" class="@inputCls" maxlength="100" />
                        <span asp-validation-for="Property.Province" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Property.Country" class="@labelCls">Country <span class="text-red-700">*</span></label>
                        <input asp-for="Property.Country" class="@inputCls" maxlength="100" />
                        <span asp-validation-for="Property.Country" class="@errCls"></span>
                    </div>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <div>
            <section class="@card" aria-labelledby="assign-heading">
                <h2 id="assign-heading" class="mb-4 font-display text-lg font-semibold text-navy">Listing details</h2>

                <div class="mb-4">
                    <label asp-for="Property.DeveloperId" class="@labelCls">Developer <span class="text-red-700">*</span></label>
                    <select asp-for="Property.DeveloperId" asp-items="Model.Developers" class="@inputCls">
                        <option value="">Select a developer</option>
                    </select>
                    <span asp-validation-for="Property.DeveloperId" class="@errCls"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Property.Status" class="@labelCls">Status <span class="text-red-700">*</span></label>
                    <select asp-for="Property.Status" class="@inputCls">
                        <option value="Available">Available</option>
                        <option value="Reserved">Reserved</option>
                        <option value="Sold">Sold</option>
                    </select>
                    <span asp-validation-for="Property.Status" class="@errCls"></span>
                </div>

                <p class="flex items-center gap-2 text-sm text-navy/60">
                    <i data-lucide="user-check" class="size-4 shrink-0" aria-hidden="true"></i>
                    This listing is automatically assigned to you.
                </p>
            </section>

            <div class="grid gap-2">
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 bg-azure px-4 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    <i data-lucide="check" class="size-4" aria-hidden="true"></i>Save property
                </button>
                <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Index"
                   class="inline-flex items-center justify-center border border-azure px-4 py-3 font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}