@using REAL_STATE.Models
@model IEnumerable<Property>
@{
    ViewData["Title"] = "My listings";
    var isActive = ViewBag.IsAgentActive as bool? ?? false;
}

@Html.AntiForgeryToken()

@if (!isActive)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-hourglass-split me-1"></i>
        Your account is pending admin approval. You can't add listings until it's approved.
    </div>
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">My listings</h1>
        <p class="text-secondary mb-0">Properties assigned to you.</p>
    </div>
    @if (isActive)
    {
        <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" class="btn btn-outline-primary">
            <i class="bi bi-plus-lg me-1"></i>Create
        </a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="card border shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="listingTable" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Listing</th>
                            <th>Price</th>
                            <th>City</th>
                            <th>Developer</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Title</td>
                                <td>@p.PropertyType</td>
                                <td>@p.ListingType</td>
                                <td data-order="@p.Price">₱@p.Price.ToString("N2")</td>
                                <td>@p.City</td>
                                <td>@p.Developer?.Name</td>
                                <td><span class="badge text-bg-light border">@p.Status</span></td>
                                <td class="text-end text-nowrap">
                                    <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert"
                                       asp-route-id="@p.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger js-delete"
                                            data-id="@p.Id"
                                            data-title="@p.Title">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center bg-white border rounded p-5">
        <i class="bi bi-house-add display-4 text-secondary"></i>
        <h2 class="h5 mt-3">No listings yet</h2>
        <p class="text-secondary">Your properties will appear here.</p>
        @if (isActive)
        {
            <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>Add property
            </a>
        }
    </div>
}

@section Scripts {
    <script src="/js/listing.js"></script>
}