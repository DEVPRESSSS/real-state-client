@using REAL_STATE.Models
@model IEnumerable<Property>
@{
    ViewData["Title"] = "My listings";
    var isActive = ViewBag.IsAgentActive as bool? ?? false;

    const string btnPrimary = "inline-flex items-center gap-2 bg-azure px-4 py-2 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";

    var rows = (Model ?? Enumerable.Empty<Property>()).Select(p => new
    {
        id = p.Id,
        title = p.Title,
        propertyType = p.PropertyType,
        listingType = p.ListingType,
        price = p.Price,
        city = p.City,
        developer = p.Developer?.Name ?? "",
        status = p.Status,
        editUrl = Url.Action("Upsert", "Listing", new { area = "AgentAndBroker", id = p.Id })
    }).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />
    <link rel="stylesheet" href="~/css/tabulator-theme.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

@if (!isActive)
{
    <div class="mb-6 flex items-start gap-3 rounded-lg border border-azure bg-ice p-4 text-navy" role="alert">
        <i data-lucide="hourglass" class="mt-0.5 size-5 shrink-0 text-azure" aria-hidden="true"></i>
        <p class="text-sm">Your account is pending admin approval. You can't add listings until it's approved.</p>
    </div>
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="mb-1 font-display text-3xl font-semibold text-navy">My listings</h1>
        <p class="text-navy/60">Properties assigned to you.</p>
    </div>
    @if (isActive)
    {
        <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" class="@btnPrimary">
            <i data-lucide="plus" class="size-4" aria-hidden="true"></i>Create
        </a>
    }
</div>

@if (rows.Any())
{
    <div class="rounded-lg border border-ice bg-white p-4 shadow-sm md:p-5">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="w-full sm:w-72">
                <label for="listingSearch" class="sr-only">Search listings</label>
                <div class="relative">
                    <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-navy/50" aria-hidden="true"></i>
                    <input id="listingSearch" type="search" placeholder="Search listings"
                           class="block w-full rounded border border-ice bg-white py-2 pl-9 pr-3 text-sm text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30" />
                </div>
            </div>
            <p id="listingCount" class="text-sm text-navy/60" aria-live="polite"></p>
        </div>

        <div id="listingTable"></div>
    </div>
}
else
{
    <div class="rounded-lg border border-ice bg-white p-12 text-center">
        <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-ice">
            <i data-lucide="house-plus" class="size-6 text-azure" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 font-display text-lg font-semibold text-navy">No listings yet</h2>
        <p class="mb-4 text-navy/60">Your properties will appear here.</p>
        @if (isActive)
        {
            <a asp-area="AgentAndBroker" asp-controller="Listing" asp-action="Upsert" class="@btnPrimary">
                <i data-lucide="plus" class="size-4" aria-hidden="true"></i>Add property
            </a>
        }
    </div>
}

@section Scripts {
    <script src="~/lib/tabulator/tabulator.min.js"></script>

    @if (rows.Any())
    {
        <script id="listingData" type="application/json">@Html.Raw(Json.Serialize(rows))</script>
        <script src="~/js/listing-table.js" asp-append-version="true"></script>
    }

    <script src="~/js/listing.js" asp-append-version="true"></script>
}