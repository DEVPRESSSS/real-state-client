@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";

    const string inputCls = "block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30";
    const string labelCls = "mb-1 block text-sm font-medium text-navy";
    const string linkCls = "font-medium text-azure hover:text-azure-dark hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
}

<div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-md">

        <div class="rounded-lg border border-ice bg-white p-6 shadow-sm md:p-10">

            <div class="mb-6 text-center">
                <h1 class="mb-1 font-display text-3xl font-semibold text-navy">Create an account</h1>
                <p class="text-navy/60">Register to save properties and send inquiries.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700" role="alert"></div>

                @* Carries the referral code from ?ref=CODE through the form post *@
                <input type="hidden" name="ref" value="@Model.ReferralCode" />

                <div class="mb-4">
                    <label asp-for="Input.FullName" class="@labelCls">Full name</label>
                    <input asp-for="Input.FullName" class="@inputCls" autocomplete="name"
                           aria-required="true" placeholder="John Doe" />
                    <span asp-validation-for="Input.FullName" class="mt-1 block text-sm text-red-700"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="@labelCls">Email</label>
                    <input asp-for="Input.Email" class="@inputCls" autocomplete="username"
                           aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="mt-1 block text-sm text-red-700"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password" class="@labelCls">Password</label>
                    <input asp-for="Input.Password" class="@inputCls" autocomplete="new-password"
                           aria-required="true" placeholder="Create a password" />
                    <span asp-validation-for="Input.Password" class="mt-1 block text-sm text-red-700"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Input.ConfirmPassword" class="@labelCls">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="@inputCls" autocomplete="new-password"
                           aria-required="true" placeholder="Re-enter your password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-sm text-red-700"></span>
                </div>

                <button id="registerSubmit" type="submit"
                        class="w-full bg-azure px-4 py-3 text-lg font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    Register
                </button>
            </form>

            <hr class="my-6 border-ice" />

            <p class="text-center text-sm text-navy/60">
                Already have an account?
                <a class="@linkCls" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
            </p>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}