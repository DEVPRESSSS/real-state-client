@using REAL_STATE.Models.VM

@model PagedResult<AppointmentListVM>

@{
    ViewData["Title"] = "Viewing Appointments";

    var rows = Model.Items.Select(a => new
    {
        id = a.Id,
        property = a.Property,
        contactName = a.ContactName,
        email = a.Email,
        phone = a.Phone ?? "",
        agent = a.Agent,
        scheduledAt = a.ScheduledAt.ToString("MMM dd, yyyy hh:mm tt"),
        scheduledTicks = a.ScheduledAt.Ticks,
        status = a.Status,
        notes = a.Notes ?? "",
        createdAt = a.CreatedAt.ToString("MMM dd, yyyy"),
        createdTicks = a.CreatedAt.Ticks
    }).ToList();
}


@Html.AntiForgeryToken()
<partial name="_Pagination" model="Model" />

<!-- Page Header -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="mb-1 font-display text-3xl font-semibold text-navy">
            Viewing Appointments
        </h1>

        <p class="text-navy/60">
            Manage property viewing requests and scheduled appointments.
        </p>
    </div>
</div>

@if (rows.Any())
{
    <div class="rounded-lg border border-ice bg-white p-4 shadow-sm md:p-5">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">

            <!-- Search -->
            <div class="w-full sm:w-72">
                <label for="appointmentSearch" class="sr-only">
                    Search appointments
                </label>

                <div class="relative">
                    <i data-lucide="search"
                       class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-navy/50"
                       aria-hidden="true"></i>

                    <input id="appointmentSearch"
                           type="search"
                           placeholder="Filter this page"
                           class="block w-full rounded border border-ice bg-white py-2 pl-9 pr-3 text-sm text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30" />
                </div>
            </div>

            <!-- Count -->
            <p id="appointmentCount"
               class="text-sm text-navy/60"
               aria-live="polite">
                @Model.TotalItems appointments
            </p>
        </div>

        <!-- Tabulator -->
        <div id="appointmentTable"></div>

        <!-- Server Pagination -->
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3">

            <p class="text-sm text-navy/60">
                Page @Model.CurrentPage of @Model.TotalPages
                <span class="mx-1">·</span>
                @Model.TotalItems total appointments
            </p>

            <div class="flex items-center gap-2">

                @if (Model.HasPreviousPage)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="rounded border border-ice px-3 py-2 text-sm font-medium text-navy transition hover:bg-snow">
                        Previous
                    </a>
                }
                else
                {
                    <span class="cursor-not-allowed rounded border border-ice px-3 py-2 text-sm text-navy/40">
                        Previous
                    </span>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="rounded bg-azure px-3 py-2 text-sm font-medium text-white transition hover:bg-azure-dark">
                        Next
                    </a>
                }
                else
                {
                    <span class="cursor-not-allowed rounded bg-ice px-3 py-2 text-sm text-navy/40">
                        Next
                    </span>
                }

            </div>
        </div>

    </div>
}
else
{
    <div class="rounded-lg border border-ice bg-white p-12 text-center">

        <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-ice">
            <i data-lucide="calendar-days"
               class="size-6 text-azure"
               aria-hidden="true"></i>
        </div>

        <h2 class="mb-1 font-display text-lg font-semibold text-navy">
            No viewing appointments yet
        </h2>

        <p class="text-navy/60">
            Viewing requests submitted by customers will appear here.
        </p>

    </div>
}


<!-- Appointment Details Modal -->
<div id="appointmentModal"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/50 p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="appointmentModalTitle">

    <div class="w-full max-w-2xl overflow-hidden rounded-lg border border-ice bg-white shadow-xl">

        <!-- Header -->
        <div class="flex items-center justify-between border-b border-ice px-6 py-4">
            <div>
                <h2 id="appointmentModalTitle"
                    class="font-display text-xl font-semibold text-navy">
                    Appointment Details
                </h2>

                <p class="text-sm text-navy/60">
                    Review the customer's property viewing request.
                </p>
            </div>

            <button type="button"
                    id="closeAppointmentModal"
                    class="rounded p-2 text-navy/50 transition hover:bg-snow hover:text-navy"
                    aria-label="Close modal">
                <i data-lucide="x" class="size-5"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="max-h-[65vh] space-y-6 overflow-y-auto p-6">

            <!-- Property -->
            <section>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-navy/50">
                    Property Information
                </h3>

                <div class="rounded-lg border border-ice bg-snow p-4">
                    <p id="modalProperty"
                       class="font-semibold text-navy">
                    </p>

                    @* <p class="mt-1 text-xs text-navy/50">
                        Property ID: <span id="modalPropertyId"></span>
                    </p> *@
                </div>
            </section>

            <!-- Customer -->
            <section>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-navy/50">
                    Customer Information
                </h3>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <p class="text-xs text-navy/50">Full Name</p>
                        <p id="modalContactName" class="mt-1 font-medium text-navy"></p>
                    </div>

                    <div>
                        <p class="text-xs text-navy/50">Email Address</p>
                        <p id="modalEmail" class="mt-1 break-all text-navy"></p>
                    </div>

                    <div>
                        <p class="text-xs text-navy/50">Phone Number</p>
                        <p id="modalPhone" class="mt-1 text-navy"></p>
                    </div>
                </div>
            </section>

            <!-- Appointment -->
            <section>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-navy/50">
                    Appointment Information
                </h3>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <p class="text-xs text-navy/50">Scheduled Date</p>
                        <p id="modalScheduledAt" class="mt-1 font-medium text-navy"></p>
                    </div>

                    <div>
                        <p class="text-xs text-navy/50">Assigned Agent</p>
                        <p id="modalAgent" class="mt-1 text-navy"></p>
                    </div>

                    <div>
                        <p class="text-xs text-navy/50">Current Status</p>
                        <p id="modalStatus" class="mt-1 font-medium text-navy"></p>
                    </div>

                    <div>
                        <p class="text-xs text-navy/50">Request Submitted</p>
                        <p id="modalCreatedAt" class="mt-1 text-navy"></p>
                    </div>
                </div>
            </section>

            <!-- Notes -->
            <section>
                <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-navy/50">
                    Customer Notes
                </h3>

                <div class="rounded-lg border border-ice bg-snow p-4">
                    <p id="modalNotes"
                       class="whitespace-pre-wrap text-sm text-navy/80">
                    </p>
                </div>
            </section>

        </div>

        <!-- Footer -->
        <div class="flex flex-wrap justify-end gap-2 border-t border-ice px-6 py-4">

            <button type="button"
                    id="cancelAppointmentModal"
                    class="rounded border border-ice px-4 py-2 text-sm font-medium text-navy transition hover:bg-snow">
                Close
            </button>

          <button type="button"
                id="approveAppointmentBtn"
                data-approve-url="@Url.Action("Approve", "Appointment", new { area = "Admin" })"
                class="inline-flex items-center gap-2 rounded bg-azure px-4 py-2 text-sm font-medium text-white transition hover:bg-azure-dark active:bg-azure-darker">
            <i data-lucide="check-circle" class="size-4"></i>
            Approve Request
        </button>

        </div>

    </div>
</div>


@section Scripts {
    <script src="~/lib/tabulator/tabulator.min.js"></script>

    @if (rows.Any())
    {
        <script id="appointmentData" type="application/json">
            @Html.Raw(Json.Serialize(rows))
        </script>

        <script src="~/js/appointment-table.js"
                asp-append-version="true"></script>
    }
}
