@using REAL_STATE.Models
@model Developers
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;
}

<div class="container py-4 py-lg-5">
    <div class="mb-4">
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">
            @(isEdit ? "Edit developer" : "Add a developer")
        </h1>
        <p class="text-secondary mb-0">Fields marked <span class="text-danger">*</span> are required.</p>
    </div>

    <form asp-area="Admin" asp-controller="Developer" asp-action="Upsert" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">

                <!-- Basic information -->
                <section class="card border shadow-sm mb-4" aria-labelledby="basic-heading">
                    <div class="card-body">
                        <h2 id="basic-heading" class="h5 mb-3">Basic information</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" maxlength="150"
                                       placeholder="e.g. Ayala Land" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Slug" class="form-label">URL slug <span class="text-danger">*</span></label>
                                <input asp-for="Slug" class="form-control" maxlength="200"
                                       placeholder="ayala-land" aria-describedby="slugHelp" />
                                <div id="slugHelp" class="form-text">Must be unique. Use lowercase letters, numbers and hyphens.</div>
                                <span asp-validation-for="Slug" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="WebsiteUrl" class="form-label">Website</label>
                                <input asp-for="WebsiteUrl" type="url" class="form-control" maxlength="300"
                                       placeholder="https://..." />
                                <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="6" maxlength="2000"
                                          placeholder="A short introduction about the developer."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-lg-4">
                <section class="card border shadow-sm mb-4" aria-labelledby="logo-heading">
                    <div class="card-body">
                        <h2 id="logo-heading" class="h5 mb-3">Branding</h2>

                        <div class="text-center mb-3">
                            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                            {
                                <img src="@Model.LogoUrl" alt="Developer logo" class="rounded object-fit-contain border bg-white"
                                     style="width:96px;height:96px;" />
                            }
                            else
                            {
                                <i class="bi bi-building display-3 text-secondary"></i>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="LogoUrl" class="form-label">Logo URL</label>
                            <input asp-for="LogoUrl" class="form-control" maxlength="500"
                                   placeholder="https://..." />
                            <span asp-validation-for="LogoUrl" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </section>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Save developer
                    </button>
                    <a asp-area="Admin" asp-controller="Developer" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}