@using REAL_STATE.Models
@model Developers
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;

    const string inputCls = "block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30";
    const string labelCls = "mb-1 block text-sm font-medium text-navy";
    const string errCls = "mt-1 block text-sm text-red-700";
    const string card = "mb-6 rounded-lg border border-ice bg-white p-6 shadow-sm";
}

<div class="mb-6">
    <h1 class="mb-1 font-display text-3xl font-semibold text-navy">
        @(isEdit ? "Edit developer" : "Add a developer")
    </h1>
    <p class="text-navy/60">Fields marked <span class="text-red-700">*</span> are required.</p>
</div>

<form asp-area="Admin" asp-controller="Developer" asp-action="Upsert" method="post" novalidate>
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700" role="alert"></div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <div class="lg:col-span-2">

            <!-- Basic information -->
            <section class="@card" aria-labelledby="basic-heading">
                <h2 id="basic-heading" class="mb-4 font-display text-lg font-semibold text-navy">Basic information</h2>
                <div class="grid grid-cols-1 gap-4">

                    <div>
                        <label asp-for="Name" class="@labelCls">Name <span class="text-red-700">*</span></label>
                        <input asp-for="Name" class="@inputCls" maxlength="150" placeholder="e.g. Ayala Land" />
                        <span asp-validation-for="Name" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Slug" class="@labelCls">URL slug <span class="text-red-700">*</span></label>
                        <input asp-for="Slug" class="@inputCls" maxlength="200"
                               placeholder="ayala-land" aria-describedby="slugHelp" />
                        <p id="slugHelp" class="mt-1 text-sm text-navy/60">Must be unique. Use lowercase letters, numbers and hyphens.</p>
                        <span asp-validation-for="Slug" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="WebsiteUrl" class="@labelCls">Website</label>
                        <input asp-for="WebsiteUrl" type="url" class="@inputCls" maxlength="300" placeholder="https://..." />
                        <span asp-validation-for="WebsiteUrl" class="@errCls"></span>
                    </div>

                    <div>
                        <label asp-for="Description" class="@labelCls">Description</label>
                        <textarea asp-for="Description" class="@inputCls" rows="6" maxlength="2000"
                                  placeholder="A short introduction about the developer."></textarea>
                        <span asp-validation-for="Description" class="@errCls"></span>
                    </div>
                </div>
            </section>
        </div>

        <!-- Sidebar -->
        <div>
            <section class="@card" aria-labelledby="logo-heading">
                <h2 id="logo-heading" class="mb-4 font-display text-lg font-semibold text-navy">Branding</h2>

                <div class="mb-4 flex justify-center">
                    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="Developer logo"
                             class="size-24 rounded border border-ice bg-white object-contain p-1" />
                    }
                    else
                    {
                        <span class="inline-flex size-24 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                            <i data-lucide="building-2" class="size-10"></i>
                        </span>
                    }
                </div>

                <div class="mb-4">
                    <label asp-for="LogoUrl" class="@labelCls">Logo URL</label>
                    <input asp-for="LogoUrl" class="@inputCls" maxlength="500" placeholder="https://..." />
                    <span asp-validation-for="LogoUrl" class="@errCls"></span>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsActive" class="size-4 rounded border-ice accent-azure focus:ring-2 focus:ring-azure" />
                    <label asp-for="IsActive" class="text-sm text-navy">Active</label>
                </div>
            </section>

            <div class="grid gap-2">
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 bg-azure px-4 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    <i data-lucide="check" class="size-4" aria-hidden="true"></i>Save developer
                </button>
                <a asp-area="Admin" asp-controller="Developer" asp-action="Index"
                   class="inline-flex items-center justify-center border border-azure px-4 py-3 font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}