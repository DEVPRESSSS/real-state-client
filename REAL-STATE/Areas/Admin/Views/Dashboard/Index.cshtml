@using REAL_STATE.Models.VM
@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";

    int Percent(int part, int total) => total == 0 ? 0 : (int)Math.Round(part * 100.0 / total);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">Dashboard</h1>
        <p class="text-secondary mb-0">Overview of your listings, people and accounts.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="Admin" asp-controller="Property" asp-action="Upsert" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New property
        </a>
        <a asp-area="Admin" asp-controller="Agent" asp-action="Upsert" class="btn btn-outline-primary">
            <i class="bi bi-person-plus me-1"></i>New agent
        </a>
    </div>
</div>

@* ---------- Stat cards ---------- *@
<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-buildings"></i></div>
                    <div>
                        <div class="text-secondary small">Total properties</div>
                        <div class="display-6 fw-semibold text-body">@Model.TotalProperties</div>
                        <div class="small text-secondary">@Model.AvailableProperties available</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-star-fill"></i></div>
                    <div>
                        <div class="text-secondary small">Featured listings</div>
                        <div class="display-6 fw-semibold text-body">@Model.FeaturedProperties</div>
                        <div class="small text-secondary">@Percent(Model.FeaturedProperties, Model.TotalProperties)% of all listings</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Developer" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info-subtle text-info-emphasis"><i class="bi bi-building"></i></div>
                    <div>
                        <div class="text-secondary small">Developers</div>
                        <div class="display-6 fw-semibold text-body">@Model.TotalDevelopers</div>
                        <div class="small text-secondary">@Model.ActiveDevelopers active</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Agent" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-person-badge"></i></div>
                    <div>
                        <div class="text-secondary small">Agents</div>
                        <div class="display-6 fw-semibold text-body">@Model.TotalAgents</div>
                        <div class="small text-secondary">@Model.ActiveAgents active</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-tag"></i></div>
                    <div>
                        <div class="text-secondary small">For sale</div>
                        <div class="display-6 fw-semibold text-body">@Model.ForSale</div>
                        <div class="small text-secondary">@Percent(Model.ForSale, Model.TotalProperties)% of listings</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-purple-subtle"><i class="bi bi-key"></i></div>
                    <div>
                        <div class="text-secondary small">For rent</div>
                        <div class="display-6 fw-semibold text-body">@Model.ForRent</div>
                        <div class="small text-secondary">@Percent(Model.ForRent, Model.TotalProperties)% of listings</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-secondary-subtle text-secondary"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="text-secondary small">Users</div>
                        <div class="display-6 fw-semibold text-body">@Model.TotalUsers</div>
                        <div class="small text-secondary">Registered accounts</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="text-decoration-none">
            <div class="card border shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon @(Model.LockedUsers > 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                        <i class="bi @(Model.LockedUsers > 0 ? "bi-lock" : "bi-shield-check")"></i>
                    </div>
                    <div>
                        <div class="text-secondary small">Locked accounts</div>
                        <div class="display-6 fw-semibold text-body">@Model.LockedUsers</div>
                        <div class="small text-secondary">@(Model.LockedUsers == 0 ? "All accounts in good standing" : "Need your attention")</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

@* ---------- Panels ---------- *@
<div class="row g-4">

    <div class="col-12 col-xl-8">
        <div class="card border shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0">Recent listings</h2>
                    <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="small">View all</a>
                </div>

                @if (Model.RecentProperties.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Developer</th>
                                    <th>Listing</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Added</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.RecentProperties)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-area="Admin" asp-controller="Property" asp-action="Upsert"
                                               asp-route-id="@p.Id" class="text-decoration-none">@p.Title</a>
                                            <div class="small text-secondary fw-normal">@p.City</div>
                                        </td>
                                        <td>@p.Developer?.Name</td>
                                        <td>
                                            <span class="badge @(p.ListingType == "Rent" ? "text-bg-info" : "text-bg-primary")">@p.ListingType</span>
                                        </td>
                                        <td>₱@p.Price.ToString("N0")</td>
                                        <td><span class="badge text-bg-light border">@p.Status</span></td>
                                        <td class="text-secondary small">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-secondary py-5">
                        <i class="bi bi-house-add display-4"></i>
                        <p class="mt-2 mb-0">No listings yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card border shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">By status</h2>
                @if (Model.PropertiesByStatus.Any())
                {
                    foreach (var s in Model.PropertiesByStatus)
                    {
                        var pct = Percent(s.Count, Model.TotalProperties);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@s.Label</span>
                                <span class="text-secondary">@s.Count (@pct%)</span>
                            </div>
                            <div class="progress" style="height:8px;" role="progressbar" aria-label="@s.Label" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
            </div>
        </div>

        <div class="card border shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">By property type</h2>
                @if (Model.PropertiesByType.Any())
                {
                    foreach (var t in Model.PropertiesByType)
                    {
                        var pct = Percent(t.Count, Model.TotalProperties);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@t.Label</span>
                                <span class="text-secondary">@t.Count (@pct%)</span>
                            </div>
                            <div class="progress" style="height:8px;" role="progressbar" aria-label="@t.Label" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width:@pct%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary small mb-0">No data yet.</p>
                }
            </div>
        </div>
    </div>
</div>

