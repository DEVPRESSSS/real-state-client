@using REAL_STATE.Models.VM
@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";

    int Percent(int part, int total) => total == 0 ? 0 : (int)Math.Round(part * 100.0 / total);

    const string btnPrimary = "inline-flex items-center gap-2 bg-azure px-4 py-2 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
    const string btnOutline = "inline-flex items-center gap-2 border border-azure px-4 py-2 font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
    const string link = "text-azure hover:text-azure-dark hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";

    const string card = "bg-white border border-ice rounded-lg shadow-sm";
    const string cardLink = "group block h-full p-4 transition-colors hover:border-azure focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
    const string iconBox = "inline-flex size-12 shrink-0 items-center justify-center rounded bg-ice text-azure";

    const string th = "px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-navy/60";
    const string td = "px-3 py-3 align-middle";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="mb-1 font-display text-3xl font-semibold text-navy">Dashboard</h1>
        <p class="text-navy/60">Overview of your listings, people and accounts.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a asp-area="Admin" asp-controller="Property" asp-action="Upsert" class="@btnPrimary">
            <i data-lucide="plus" class="size-4" aria-hidden="true"></i>New property
        </a>
        <a asp-area="Admin" asp-controller="Agent" asp-action="Upsert" class="@btnOutline">
            <i data-lucide="user-plus" class="size-4" aria-hidden="true"></i>New agent
        </a>
    </div>
</div>

@* ---------- Stat cards ---------- *@
<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <div class="@card">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="building-2" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">Total properties</div>
                    <div class="text-3xl font-semibold text-navy">@Model.TotalProperties</div>
                    <div class="text-sm text-navy/60">@Model.AvailableProperties available</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="star" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">Featured listings</div>
                    <div class="text-3xl font-semibold text-navy">@Model.FeaturedProperties</div>
                    <div class="text-sm text-navy/60">@Percent(Model.FeaturedProperties, Model.TotalProperties)% of all listings</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="Developer" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="building" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">Developers</div>
                    <div class="text-3xl font-semibold text-navy">@Model.TotalDevelopers</div>
                    <div class="text-sm text-navy/60">@Model.ActiveDevelopers active</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="Agent" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="contact-round" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">Agents</div>
                    <div class="text-3xl font-semibold text-navy">@Model.TotalAgents</div>
                    <div class="text-sm text-navy/60">@Model.ActiveAgents active</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="tag" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">For sale</div>
                    <div class="text-3xl font-semibold text-navy">@Model.ForSale</div>
                    <div class="text-sm text-navy/60">@Percent(Model.ForSale, Model.TotalProperties)% of listings</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="key-round" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">For rent</div>
                    <div class="text-3xl font-semibold text-navy">@Model.ForRent</div>
                    <div class="text-sm text-navy/60">@Percent(Model.ForRent, Model.TotalProperties)% of listings</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox"><i data-lucide="users" class="size-6" aria-hidden="true"></i></div>
                <div>
                    <div class="text-sm text-navy/60">Users</div>
                    <div class="text-3xl font-semibold text-navy">@Model.TotalUsers</div>
                    <div class="text-sm text-navy/60">Registered accounts</div>
                </div>
            </div>
        </a>
    </div>

    <div class="@card">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="@cardLink rounded-lg">
            <div class="flex items-center gap-4">
                <div class="@iconBox">
                    <i data-lucide="@(Model.LockedUsers > 0 ? "lock" : "shield-check")" class="size-6" aria-hidden="true"></i>
                </div>
                <div>
                    <div class="text-sm text-navy/60">Locked accounts</div>
                    <div class="text-3xl font-semibold text-navy">@Model.LockedUsers</div>
                    <div class="text-sm text-navy/60">@(Model.LockedUsers == 0 ? "All accounts in good standing" : "Need your attention")</div>
                </div>
            </div>
        </a>
    </div>
</div>

@* ---------- Panels ---------- *@
<div class="grid grid-cols-1 gap-6 xl:grid-cols-3">

    <section class="@card p-5 xl:col-span-2" aria-labelledby="recent-heading">
        <div class="mb-4 flex items-center justify-between">
            <h2 id="recent-heading" class="font-display text-lg font-semibold text-navy">Recent listings</h2>
            <a asp-area="Admin" asp-controller="Property" asp-action="Index" class="text-sm font-medium @link">View all</a>
        </div>

        @if (Model.RecentProperties.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[640px] text-sm">
                    <thead class="bg-ice">
                        <tr>
                            <th class="@th">Title</th>
                            <th class="@th">Developer</th>
                            <th class="@th">Listing</th>
                            <th class="@th">Price</th>
                            <th class="@th">Status</th>
                            <th class="@th">Added</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ice">
                        @foreach (var p in Model.RecentProperties)
                        {
                            <tr class="hover:bg-ice/40">
                                <td class="@td">
                                    <a asp-area="Admin" asp-controller="Property" asp-action="Upsert"
                                       asp-route-id="@p.Id"
                                       class="font-semibold @link">@p.Title</a>
                                    <div class="text-xs text-navy/60">@p.City</div>
                                </td>
                                <td class="@td text-navy">@p.Developer?.Name</td>
                                <td class="@td">
                                    @if (p.ListingType == "Rent")
                                    {
                                        <span class="inline-flex rounded border border-azure bg-white px-2 py-0.5 text-xs font-medium text-azure">Rent</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded bg-ice px-2 py-0.5 text-xs font-medium text-navy">@p.ListingType</span>
                                    }
                                </td>
                                <td class="@td whitespace-nowrap text-navy">₱@p.Price.ToString("N0")</td>
                                <td class="@td">
                                    <span class="inline-flex rounded bg-ice px-2 py-0.5 text-xs font-medium text-navy">@p.Status</span>
                                </td>
                                <td class="@td whitespace-nowrap text-xs text-navy/60">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-12 text-center text-navy/60">
                <i data-lucide="house-plus" class="mx-auto size-12" aria-hidden="true"></i>
                <p class="mt-2">No listings yet.</p>
            </div>
        }
    </section>

    <div class="space-y-6">

        <section class="@card p-5" aria-labelledby="status-heading">
            <h2 id="status-heading" class="mb-4 font-display text-lg font-semibold text-navy">By status</h2>
            @if (Model.PropertiesByStatus.Any())
            {
                foreach (var s in Model.PropertiesByStatus)
                {
                    var pct = Percent(s.Count, Model.TotalProperties);
                    <div class="mb-4 last:mb-0">
                        <div class="mb-1 flex justify-between text-sm">
                            <span class="text-navy">@s.Label</span>
                            <span class="text-navy/60">@s.Count (@pct%)</span>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded-full bg-ice" role="progressbar"
                             aria-label="@s.Label" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full rounded-full bg-azure" style="width:@pct%"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-navy/60">No data yet.</p>
            }
        </section>

        <section class="@card p-5" aria-labelledby="type-heading">
            <h2 id="type-heading" class="mb-4 font-display text-lg font-semibold text-navy">By property type</h2>
            @if (Model.PropertiesByType.Any())
            {
                foreach (var t in Model.PropertiesByType)
                {
                    var pct = Percent(t.Count, Model.TotalProperties);
                    <div class="mb-4 last:mb-0">
                        <div class="mb-1 flex justify-between text-sm">
                            <span class="text-navy">@t.Label</span>
                            <span class="text-navy/60">@t.Count (@pct%)</span>
                        </div>
                        <div class="h-2 w-full overflow-hidden rounded-full bg-ice" role="progressbar"
                             aria-label="@t.Label" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            <div class="h-full rounded-full bg-navy" style="width:@pct%"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-navy/60">No data yet.</p>
            }
        </section>
    </div>
</div>