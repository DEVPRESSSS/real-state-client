@using REAL_STATE.Models
@model Agent
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;
}

<div class="container py-4 py-lg-5">
    <div class="mb-4">
        <h1 class="h2 mb-1" style="font-family:'Playfair Display',serif;">
            @(isEdit ? "Edit agent" : "Add an agent")
        </h1>
        <p class="text-secondary mb-0">Fields marked <span class="text-danger">*</span> are required.</p>
    </div>

    <form asp-area="Admin" asp-controller="Agent" asp-action="Upsert" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-8">

                <!-- Personal information -->
                <section class="card border shadow-sm mb-4" aria-labelledby="personal-heading">
                    <div class="card-body">
                        <h2 id="personal-heading" class="h5 mb-3">Personal information</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label">Full name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" maxlength="150"
                                       placeholder="e.g. Maria Santos" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" maxlength="200"
                                       placeholder="agent@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" type="tel" class="form-control" maxlength="30"
                                       placeholder="+63 900 000 0000" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Bio" class="form-label">Bio</label>
                                <textarea asp-for="Bio" class="form-control" rows="6" maxlength="2000"
                                          placeholder="A short introduction shown on the agent's profile."></textarea>
                                <span asp-validation-for="Bio" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Professional details -->
                <section class="card border shadow-sm mb-4" aria-labelledby="pro-heading">
                    <div class="card-body">
                        <h2 id="pro-heading" class="h5 mb-3">Professional details</h2>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="LicenseNumber" class="form-label">License number</label>
                                <input asp-for="LicenseNumber" class="form-control" maxlength="50" />
                                <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Role" class="form-label">Role <span class="text-danger">*</span></label>
                                <select asp-for="Role" class="form-select">
                                    <option value="Agent">Agent</option>
                                    <option value="Broker">Broker</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-lg-4">
                <section class="card border shadow-sm mb-4" aria-labelledby="photo-heading">
                    <div class="card-body">
                        <h2 id="photo-heading" class="h5 mb-3">Profile</h2>

                        <div class="text-center mb-3">
                            @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
                            {
                                <img src="@Model.PhotoUrl" alt="Agent photo" class="rounded-circle object-fit-cover"
                                     style="width:96px;height:96px;" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle display-3 text-secondary"></i>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhotoUrl" class="form-label">Photo URL</label>
                            <input asp-for="PhotoUrl" class="form-control" maxlength="500"
                                   placeholder="https://..." />
                            <span asp-validation-for="PhotoUrl" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </section>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i>Save agent
                    </button>
                    <a asp-area="Admin" asp-controller="Agent" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}