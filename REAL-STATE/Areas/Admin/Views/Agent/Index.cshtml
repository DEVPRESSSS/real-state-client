@using REAL_STATE.Models
@model REAL_STATE.Models.VM.PagedResult<Agent>
@{
    ViewData["Title"] = "Agents";

    const string btnPrimary = "inline-flex items-center gap-2 bg-azure px-4 py-2 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";

    var rows = Model.Items.Select(a => new
    {
        id = a.Id,
        agent = a.FullName,
        email = a.Email,
        phone = a.Phone,
        license = a.LicenseNumber,
        role = a.Role,
        status = a.IsActive ? "Active" : "Inactive",
        photoUrl = a.PhotoUrl,
        editUrl = Url.Action("Upsert", "Agent", new { area = "Admin", id = a.Id })
    }).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />

}

@Html.AntiForgeryToken()
<partial name="_TableSearch" />
<partial name="_Pagination" model="Model" />

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="mb-1 font-display text-3xl font-semibold text-navy">Agents</h1>
        <p class="text-navy/60">Manage agents and brokers.</p>
    </div>
    <a asp-area="Admin" asp-controller="Agent" asp-action="Upsert" class="@btnPrimary">
        <i data-lucide="plus" class="size-4" aria-hidden="true"></i>Create
    </a>
</div>

@if (rows.Any())
{
    <div class="rounded-lg border border-ice bg-white p-4 shadow-sm md:p-5">

        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="w-full sm:w-72">
                <label for="agentSearch" class="sr-only">Search agents</label>
                <div class="relative">
                    <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-navy/50" aria-hidden="true"></i>
                    <input id="agentSearch" type="search" aria-label="Filter this page" placeholder="Filter this page"
                           class="block w-full rounded border border-ice bg-white py-2 pl-9 pr-3 text-sm text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30" />
                </div>
            </div>
            <p id="agentCount" class="text-sm text-navy/60" aria-live="polite"></p>
        </div>

        <div id="agentTable"></div>
    </div>
}
else
{
    <div class="rounded-lg border border-ice bg-white p-12 text-center">
        <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-ice">
            <i data-lucide="contact-round" class="size-6 text-azure" aria-hidden="true"></i>
        </div>
        <h2 class="mb-1 font-display text-lg font-semibold text-navy">No agents yet</h2>
        <p class="mb-4 text-navy/60">Add your first agent to see them listed here.</p>
        <a asp-area="Admin" asp-controller="Agent" asp-action="Upsert" class="@btnPrimary">
            <i data-lucide="plus" class="size-4" aria-hidden="true"></i>Add agent
        </a>
    </div>
}

@section Scripts {
    <script src="~/lib/tabulator/tabulator.min.js"></script>

    @if (rows.Any())
    {
        <script id="agentData" type="application/json">@Html.Raw(Json.Serialize(rows))</script>
        <script src="~/js/agent-table.js" asp-append-version="true"></script>
    }
}
