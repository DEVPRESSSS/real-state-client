@using Microsoft.AspNetCore.Identity
@using REAL_STATE.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "text-azure hover:text-azure-dark font-semibold"
            : "text-gray-700 hover:text-blue-700";

    var isSignedIn = SignInManager.IsSignedIn(User);
    var displayName = "";
    var initial = "?";

    if (isSignedIn)
    {
        var appUser = await UserManager.GetUserAsync(User);
        displayName = !string.IsNullOrWhiteSpace(appUser?.FullName)
            ? appUser!.FullName
            : (User.Identity?.Name ?? "Account");

        if (!string.IsNullOrWhiteSpace(displayName))
        {
            initial = displayName.Trim()[0].ToString().ToUpper();
        }
    }

    var logoutReturnUrl = Url.Action("Index", "Home", new { area = "" });
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - REAL_STATE</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL_STATE.styles.css" asp-append-version="true" />

    <!--Google Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <!--Tailwind Icons-->
</head>
<body class="bg-snow text-gray-900 antialiased">

    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white border border-ice">
        <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Main navigation">

            <div class="flex h-16 items-center justify-between gap-4">

                <!-- Brand -->
                <a class="shrink-0 text-2xl font-bold tracking-tight text-azure  rounded"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    Realty
                </a>

                <!-- Desktop navigation -->
                <ul class="hidden lg:flex lg:items-center lg:gap-2">
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Hero")"
                           asp-area="" asp-controller="Home" asp-action="Hero">
                            Home
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Index")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            Properties
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Developers")"
                           asp-area="" asp-controller="Home" asp-action="Developers">
                            Developers
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Agents")"
                           asp-area="" asp-controller="Home" asp-action="Agents">
                            Agents &amp; Brokers
                        </a>
                    </li>

                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Privacy")"
                           asp-area="" asp-controller="Home" asp-action="Privacy">
                            About Us
                        </a>
                    </li>
                </ul>

                <!-- Desktop account actions -->
                <div class="hidden lg:flex lg:items-center">
                    @if (isSignedIn)
                    {
                        <div class="relative" data-dropdown>
                            <button type="button"
                                    class="flex items-center gap-2 rounded-md border border-blue-600 px-3 py-1.5 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                                    data-toggle="#userMenu"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    aria-controls="userMenu">
                                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white">
                                    @initial
                                </span>
                                <span class="max-w-[10rem] truncate">@displayName</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>

                            <div id="userMenu"
                                 class="absolute right-0 mt-2 hidden w-64 origin-top-right overflow-hidden rounded-md border border-gray-200 bg-white shadow-lg">
                                <div class="px-4 py-3 text-xs text-gray-500">
                                    Signed in as
                                    <span class="mt-0.5 block break-all text-sm font-semibold text-gray-900">@User.Identity?.Name</span>
                                </div>
                                <div class="border-t border-gray-100"></div>
                                <form method="post" class="m-0"
                                      asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@logoutReturnUrl">
                                    <button type="submit"
                                            class="flex w-full items-center gap-2 px-4 py-2.5 text-left text-sm text-red-600 transition-colors hover:bg-gray-50 focus:outline-none focus-visible:bg-gray-50">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="rounded-md border border-blue-600 px-4 py-2 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-600 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                           asp-area="Identity" asp-page="/Account/Login">
                            Sign In
                        </a>
                    }
                </div>

                <!-- Mobile toggle -->
                <button type="button"
                        class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 transition-colors hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 lg:hidden"
                        data-toggle="#mobileMenu"
                        aria-controls="mobileMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list text-2xl" data-icon-open aria-hidden="true"></i>
                    <i class="bi bi-x-lg hidden text-xl" data-icon-close aria-hidden="true"></i>
                </button>
            </div>

            <!-- Mobile menu -->
            <div id="mobileMenu" class="hidden border-t border-gray-200 pb-4 lg:hidden">
                <ul class="space-y-1 pt-3">
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Index")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            Properties
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Developers")"
                           asp-area="" asp-controller="Home" asp-action="Developers">
                            Developers
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Agents")"
                           asp-area="" asp-controller="Home" asp-action="Agents">
                            Agents &amp; Brokers
                        </a>
                    </li>
                </ul>

                <div class="mt-3 border-t border-gray-200 pt-4">
                    @if (isSignedIn)
                    {
                        <div class="mb-3 flex items-center gap-3 px-3">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white">
                                @initial
                            </span>
                            <div class="min-w-0">
                                <div class="truncate text-sm font-semibold text-gray-900">@displayName</div>
                                <div class="truncate text-xs text-gray-500">@User.Identity?.Name</div>
                            </div>
                        </div>

                        <form method="post" class="m-0"
                              asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@logoutReturnUrl">
                            <button type="submit"
                                    class="flex w-full items-center justify-center gap-2 rounded-md border border-red-200 px-4 py-2.5 text-sm font-medium text-red-600 transition-colors hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Sign out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="block w-full rounded-md border border-blue-600 px-4 py-2.5 text-center text-sm font-medium text-blue-700 transition-colors hover:bg-blue-600 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                           asp-area="Identity" asp-page="/Account/Login">
                            Sign In
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Navbar: mobile menu + user dropdown -->
    <script>
        (function () {
        var toggles = document.querySelectorAll('[data-toggle]');

        function setOpen(btn, menu, open) {
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        var iconOpen = btn.querySelector('[data-icon-open]');
        var iconClose = btn.querySelector('[data-icon-close]');
        if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        }
        }

        toggles.forEach(function (btn) {
        var menu = document.querySelector(btn.getAttribute('data-toggle'));
        if (!menu) return;

        btn.addEventListener('click', function (e) {
        e.stopPropagation();
        setOpen(btn, menu, menu.classList.contains('hidden'));
        });
        });

        // Close the user dropdown when clicking elsewhere or pressing Escape
        document.addEventListener('click', function (e) {
        document.querySelectorAll('[data-dropdown]').forEach(function (dd) {
        if (dd.contains(e.target)) return;
        var btn = dd.querySelector('[data-toggle]');
        var menu = dd.querySelector('div[id]');
        if (btn && menu) setOpen(btn, menu, false);
        });
        });

        document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        toggles.forEach(function (btn) {
        var menu = document.querySelector(btn.getAttribute('data-toggle'));
        if (menu && !menu.classList.contains('hidden')) {
        setOpen(btn, menu, false);
        btn.focus();
        }
        });
        });
        })();
    </script>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>
            Swal.fire({ icon: 'success', title: @Html.Raw(Json.Serialize(successMsg)) });
        </script>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>
            Swal.fire({ icon: 'error', title: 'Something went wrong', text: @Html.Raw(Json.Serialize(errorMsg)) });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>