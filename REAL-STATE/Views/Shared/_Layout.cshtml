
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - REAL_STATE</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL_STATE.styles.css" asp-append-version="true" />

    <!--Google Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
          rel="stylesheet">

</head>
<body class="bg-white">

    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-3">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="d-inline-flex align-items-center justify-content-center
                        bg-success text-white rounded-3"
                          style="width: 42px; height: 42px;">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24" height="24"
                             fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-7h6v7" />
                        </svg>
                    </span>

                    <span class="d-flex flex-column lh-sm">
                        <span class="text-success fs-5">Haven</span>
                        <small class="text-secondary"
                               style="font-size: 10px; letter-spacing: 2px;">
                            REAL ESTATE
                        </small>
                    </span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto gap-lg-2 my-3 my-lg-0">


                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-success"
                               asp-controller="Home"
                               asp-action="Property"
                                >
                                Properties
                            </a>
                        </li>
                       
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Developers"
                               asp-action="Index">
                                Developers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Agents"
                               asp-action="Index">
                                Agents & Brokers
                            </a>
                        </li>

                    </ul>

                    <!-- Account Actions -->
                    <div class="d-flex flex-column flex-lg-row align-items-stretch
                        align-items-lg-center gap-3">

                        <a class="btn btn-light border-0 text-dark"
                           asp-controller="Bookmarks"
                           asp-action="Index"
                           aria-label="Saved properties">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="18" height="18"
                                 fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="1.8"
                                 class="me-1">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                            </svg>
                            Saved
                        </a>

                        <a class="btn btn-outline-success px-3"
                           asp-area="Identity"
                           asp-page="/Account/Login">
                            Sign In
                        </a>

                        <a class="btn btn-success px-3"
                           asp-controller="Home"
                           asp-action="Contact">
                            List a Property
                        </a>

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

 

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
