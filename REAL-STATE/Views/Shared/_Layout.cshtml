@using Microsoft.AspNetCore.Identity
@using REAL_STATE.Models
@using REAL_STATE.Utilities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "text-azure hover:text-azure-dark font-semibold"
            : "text-gray-700 hover:text-blue-700";

    var isSignedIn = SignInManager.IsSignedIn(User);
    var displayName = "";
    var initial = "?";

    if (isSignedIn)
    {
        var appUser = await UserManager.GetUserAsync(User);
        displayName = !string.IsNullOrWhiteSpace(appUser?.FullName)
            ? appUser!.FullName
            : (User.Identity?.Name ?? "Account");

        if (!string.IsNullOrWhiteSpace(displayName))
        {
            initial = displayName.Trim()[0].ToString().ToUpper();
        }
    }

    var logoutReturnUrl = Url.Action("Index", "Home", new { area = "" });
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SHR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL-STATE.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/Logo.ico"/>
    <!--Google Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">
    <!--Tailwind Icons-->
</head>
<body class="bg-snow text-gray-900 antialiased">

    <header class="sticky top-0 z-50 border-b border-gray-200 bg-white border border-ice">
        <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Main navigation">

            <div class="flex h-20 items-center justify-between gap-4">

                <!-- Brand -->
                <a class="shrink-0 flex items-center rounded"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img class="h-10 sm:h-12 md:h-14 lg:h-15 w-auto max-w-[180px] sm:max-w-[220px] object-contain"
                         src="/images/Logo.png"
                         alt="SouthernHomesRealty" />
                </a>

                <!-- Desktop navigation -->
                <ul class="hidden lg:flex lg:items-center lg:gap-2">
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors) @NavClass("Home", "Hero")"
                           asp-controller="Home" asp-action="Hero">
                            Home
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Index")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            Properties
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Developers")"
                           asp-area="" asp-controller="Home" asp-action="Developers">
                            Developers
                        </a>
                    </li>
                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Agents")"
                           asp-area="" asp-controller="Home" asp-action="Agents">
                            Agents &amp; Brokers
                        </a>
                    </li>

                    <li>
                        <a class="rounded-md px-3 py-2 text-sm transition-colors @NavClass("Home", "Privacy")"
                           asp-area="" asp-controller="Home" asp-action="Privacy">
                            About Us
                        </a>
                    </li>
                </ul>

                <!-- Desktop account actions -->
                <div class="hidden lg:flex lg:items-center">
                    @if (isSignedIn)
                    {
                        <div class="relative" data-dropdown>
                            <button type="button"
                                    class="flex items-center gap-2 rounded-md border border-blue-600 px-3 py-1.5 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                                    data-toggle="#userMenu"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    aria-controls="userMenu">
                                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-600 text-xs font-semibold text-white">
                                    @initial
                                </span>
                                <span class="max-w-[10rem] truncate">@displayName</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>

                            <div id="userMenu"
                                 class="absolute right-0 mt-2 hidden w-64 origin-top-right overflow-hidden rounded-md border border-gray-200 bg-white shadow-lg">
                                <div class="px-4 py-3 text-xs text-gray-500">
                                    Signed in as
                                    <span class="mt-0.5 block break-all text-sm font-semibold text-gray-900">@User.Identity?.Name</span>
                                </div>
                                <div class="border-t border-gray-100"></div>
                                <form method="post" class="m-0"
                                      asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@logoutReturnUrl">
                                    <button type="submit"
                                            class="flex w-full items-center gap-2 px-4 py-2.5 text-left text-sm text-red-600 transition-colors hover:bg-gray-50 focus:outline-none focus-visible:bg-gray-50">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="rounded-md border border-blue-600 px-4 py-2 text-sm font-medium text-blue-700 transition-colors hover:bg-blue-600 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                           asp-area="Identity" asp-page="/Account/Login">
                            Sign In
                        </a>
                    }
                </div>

                <!-- Mobile toggle -->
                <button type="button"
                        class="inline-flex items-center justify-center rounded-md border border-gray-300 text-navy p-2
                    transition-colors hover:bg-azure/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 lg:hidden"
                        data-toggle="#mobileMenu"
                        aria-controls="mobileMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <i data-lucide="menu"
                       data-icon-open
                       class="size-6"></i>

                    <i data-lucide="x"
                       data-icon-close
                       class="hidden size-6"></i>
                </button>
            </div>

            <!-- Mobile menu -->
            <div id="mobileMenu" class="hidden border-t border-gray-200 pb-4 lg:hidden">
                <ul class="space-y-1 pt-3">
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Hero")"
                           asp-area="" asp-controller="Home" asp-action="Hero">
                            Home
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Index")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            Properties
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Developers")"
                           asp-area="" asp-controller="Home" asp-action="Developers">
                            Developers
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Agents")"
                           asp-area="" asp-controller="Home" asp-action="Agents">
                            Agents &amp; Brokers
                        </a>
                    </li>
                    <li>
                        <a class="block rounded-md px-3 py-2.5 text-base @NavClass("Home", "Privacy")"
                           asp-area="" asp-controller="Home" asp-action="Privacy">
                            About Us
                        </a>
                    </li>
                </ul>

                <div class="mt-3 border-t border-gray-200 pt-4">
                    @if (isSignedIn)
                    {
                        <div class="mb-3 flex items-center gap-3 px-3">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white">
                                @initial
                            </span>
                            <div class="min-w-0">
                                <div class="truncate text-sm font-semibold text-gray-900">@displayName</div>
                                <div class="truncate text-xs text-gray-500">@User.Identity?.Name</div>
                            </div>
                        </div>

                        <form method="post" class="m-0"
                              asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@logoutReturnUrl">
                            <button type="submit"
                                    class="flex w-full items-center justify-center gap-2 rounded-md border border-red-200 px-4 py-2.5 text-sm font-medium text-red-600 transition-colors hover:bg-red-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Sign out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="block w-full rounded-md border border-azure px-4 py-2.5 text-center text-sm font-medium text-navy transition-colors hover:bg-blue-600 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                           asp-area="Identity" asp-page="/Account/Login">
                            Sign In
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-navy text-white sticky" aria-label="Site footer">
        <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">

                <!-- Brand -->
                <div class="lg:col-span-2">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="font-display text-2xl font-bold tracking-tight text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy">
                        SHR
                    </a>
                    <p class="mt-3 max-w-sm text-sm text-white/70">
                        Browse listings from developers, agents and brokers in one place.
                    </p>
                </div>

                <!-- Explore -->
                <nav aria-label="Explore">
                    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/60">Explore</h2>
                    <ul class="space-y-2 text-sm">
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Hero">Home</a></li>
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Index">Properties</a></li>
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Developers">Developers</a></li>
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Agents">Agents &amp; Brokers</a></li>
                    </ul>
                </nav>

                <!-- Join -->
                <nav aria-label="Join">
                    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/60">Join</h2>
                    <ul class="space-y-2 text-sm">
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="Identity" asp-page="/Account/Register">Create an account</a></li>
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Register">Apply as an advisor</a></li>
                        <li><a class="text-white/80 hover:text-white hover:underline" asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
                    </ul>
                </nav>
            </div>

            <div class="mt-10 flex flex-col gap-2 border-t border-white/15 pt-6 text-sm text-white/60 sm:flex-row sm:items-center sm:justify-between">
                <p>&copy; @DateTime.Now.Year Realty. All rights reserved.</p>
                <a class="hover:text-white hover:underline" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/table-utils.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>

    <!-- Navbar: mobile menu + user dropdown -->

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>
            Swal.fire({ icon: 'success', title: @Html.Raw(Json.Serialize(successMsg)) });
        </script>
    }

    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>
            Swal.fire({ icon: 'error', title: 'Something went wrong', text: @Html.Raw(Json.Serialize(errorMsg)) });
        </script>
    }

    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        lucide.createIcons();
    </script>

</body>
</html>
