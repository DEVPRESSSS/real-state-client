<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - REAL_STATE</title>

    <script type="importmap"></script>

    <!-- Restore sidebar state before first paint (prevents flicker) -->
    <script>
        try {
        if (localStorage.getItem("sidebar-collapsed") === "1")
        document.documentElement.classList.add("sidebar-collapsed");
        } catch (e) { }
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL_STATE.styles.css" asp-append-version="true" />

    <!--Google Fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
          rel="stylesheet">
</head>
<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-3" aria-label="Main">
            <div class="container-fluid px-3 px-lg-4">

                <div class="d-flex align-items-center gap-2">
                    <!-- Sidebar toggle -->
                    <button id="sidebarToggle"
                            class="btn btn-light border-0 p-2 d-inline-flex"
                            type="button"
                            aria-controls="appSidebar"
                            aria-expanded="true"
                            aria-label="Toggle sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"
                             aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18" />
                        </svg>
                    </button>

                    <!-- Brand -->
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold me-0"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="d-inline-flex align-items-center justify-content-center
                            bg-success text-white rounded-3"
                              style="width: 42px; height: 42px;">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="24" height="24"
                                 fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-7h6v7" />
                            </svg>
                        </span>

                        <span class="d-flex flex-column lh-sm text-start">
                            <span class="text-success fs-5">Haven</span>
                            <small class="text-secondary"
                                   style="font-size: 10px; letter-spacing: 2px;">
                                REAL ESTATE
                            </small>
                        </span>
                    </a>
                </div>

                <!-- Top navigation (desktop). On mobile these live in the sidebar. -->
                <ul class="navbar-nav d-none d-lg-flex flex-row mx-auto gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-success"
                           asp-controller="Properties" asp-action="Index" asp-route-listingType="Sale">Buy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Properties" asp-action="Index" asp-route-listingType="Rent">Rent</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Developers" asp-action="Index">Developers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Agents" asp-action="Index">Agents &amp; Brokers</a>
                    </li>
                </ul>

                <!-- Account actions (desktop) -->
                <div class="d-none d-lg-flex align-items-center gap-3">
                    <a class="btn btn-light border-0 text-dark"
                       asp-controller="Bookmarks" asp-action="Index"
                       aria-label="Saved properties">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"
                             class="me-1" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" />
                        </svg>
                        Saved
                    </a>
                    <a class="btn btn-outline-success px-3"
                       asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                    <a class="btn btn-success px-3"
                       asp-controller="Home" asp-action="Contact">List a Property</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell">
        <partial name="_Sidebar" />
        <div class="app-backdrop" id="sidebarBackdrop"></div>

        <!-- Main Content -->
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
