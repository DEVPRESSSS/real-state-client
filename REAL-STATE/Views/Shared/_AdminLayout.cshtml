
@using REAL_STATE.Utilities
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    const string linkBase = "flex items-center gap-3 whitespace-nowrap rounded px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:group-[.sidebar-collapsed]/shell:justify-center lg:group-[.sidebar-collapsed]/shell:px-0";
    const string linkActive = "bg-azure text-white";
    const string linkIdle = "text-navy hover:bg-ice";
    const string iconCls = "size-5 shrink-0";
    const string labelCls = "lg:group-[.sidebar-collapsed]/shell:hidden";

    string NavClass(string controller) =>
        $"{linkBase} " + (string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? linkActive
            : linkIdle);
}

<!DOCTYPE html>
<html lang="en" class="group/shell">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - REAL_STATE</title>

    <script type="importmap"></script>

    <!-- Restore sidebar state before first paint (prevents flicker) -->
    <script>
        try {
        if (localStorage.getItem('adminSidebarCollapsed') === '1') {
        document.documentElement.classList.add('sidebar-collapsed');
        }
        } catch (e) { }
    </script>

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL_STATE.styles.css" asp-append-version="true" />

     <!-- Tabulator Js-->
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-snow font-sans text-navy antialiased">

    <!-- Header -->
    <header class="sticky top-0 z-30 border-b border-ice bg-white">
        <div class="flex items-center justify-between px-4 py-3 lg:px-6">

            <div class="flex items-center gap-2">

                <!-- Sidebar toggle (mobile) -->
                <button id="sidebarOpen"
                        type="button"
                        class="inline-flex size-10 items-center justify-center rounded text-navy hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:hidden"
                        aria-controls="adminSidebar"
                        aria-expanded="false"
                        aria-label="Open admin menu">

                    <i data-lucide="menu" class="size-6" aria-hidden="true"></i>
                </button>

                <!-- Sidebar toggle (desktop): collapse to icons -->
                <button id="sidebarToggle"
                        type="button"
                        class="hidden size-10 items-center justify-center rounded text-navy hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:inline-flex"
                        aria-controls="adminSidebar"
                        aria-label="Collapse or expand sidebar">

                    <i data-lucide="panel-left" class="size-5" aria-hidden="true"></i>
                </button>

                <!-- Brand -->
                <a class="ml-1 font-display text-2xl font-bold tracking-tight text-navy"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Realty
                </a>
            </div>

            <!-- Sign out -->
            <form method="post"
                  class="m-0"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button type="submit"
                        class="inline-flex items-center gap-2 border border-ice bg-white px-3 py-1.5 text-sm font-medium text-navy
                        transition-colors hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">

                    <i data-lucide="log-out" class="size-4" aria-hidden="true"></i>
                    Sign out
                </button>
            </form>
        </div>
    </header>

    <!-- Mobile backdrop -->
    <div id="sidebarBackdrop"
         class="fixed inset-0 z-30 hidden bg-navy/50 lg:hidden"
         aria-hidden="true">
    </div>

    <div class="flex">''
        <!-- Sidebar -->
        <aside id="adminSidebar"
               class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col overflow-x-hidden border-r border-ice bg-white transition-all
                duration-200 lg:sticky lg:top-[65px] lg:z-20 lg:h-[calc(100vh-65px)] lg:w-[250px] lg:shrink-0 lg:translate-x-0 lg:group-[.sidebar-collapsed]/shell:w-[76px]"
               aria-label="Admin sidebar">

            <!-- Mobile sidebar header -->
            <div class="flex items-center justify-between border-b border-ice px-4 py-3 lg:hidden">

                <h2 class="text-base font-medium text-navy">
                    Admin menu
                </h2>

                <button id="sidebarClose"
                        type="button"
                        class="inline-flex size-9 items-center justify-center rounded text-navy hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure"
                        aria-label="Close admin menu">

                    <i data-lucide="x" class="size-5" aria-hidden="true"></i>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto overflow-x-hidden p-3"
                 aria-label="Admin">

                <ul class="flex flex-col gap-1">

                    <!-- Admin navigation -->
                    @if (User.IsInRole(RoleSD.Admin))
                    {
                        <li>
                            <a class="@NavClass("Dashboard")"
                               title="Dashboard"
                               asp-area="Admin"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                <i data-lucide="layout-dashboard"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Dashboard</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("Property")"
                               title="Property"
                               asp-area="Admin"
                               asp-controller="Property"
                               asp-action="Index">

                                <i data-lucide="building-2"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Property</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("Developer")"
                               title="Developers"
                               asp-area="Admin"
                               asp-controller="Developer"
                               asp-action="Index">

                                <i data-lucide="building"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Developers</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("Agent")"
                               title="Agents"
                               asp-area="Admin"
                               asp-controller="Agent"
                               asp-action="Index">

                                <i data-lucide="contact-round"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Agents</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("User")"
                               title="Users"
                               asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index">

                                <i data-lucide="users"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Users</span>
                            </a>
                        </li>

                        @* <li>
                            <a class="@NavClass("Appointment")"
                               title="Appointments"
                               asp-area="Admin"
                               asp-controller="Appointment"
                               asp-action="Index">

                                <i data-lucide="notebook-text"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Logs</span>
                            </a>
                        </li> *@

                        <li>
                            <a class="@NavClass("Appointment")"
                               title="Appointments"
                               asp-area="Admin"
                               asp-controller="Appointment"
                               asp-action="Index">

                                <i data-lucide="calendar-check"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Appointments</span>
                            </a>
                        </li>
                    }

                    <!-- Agent navigation -->
                    @if (User.IsInRole(RoleSD.Agent))
                    {
                        <li>
                            <a class="@NavClass("")"
                               title="Listing"
                               href="#">

                                <i data-lucide="clipboard-list"
                                   class="@iconCls"
                                   aria-hidden="true"></i>

                                <span class="@labelCls">Listing</span>
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        </aside>

        <!-- Main content -->
        <main role="main"
              class="min-w-0 flex-1 bg-white p-4 lg:p-6">
            @RenderBody()
        </main>
    </div>

    <!-- JavaScript dependencies -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Sweet Alert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Tabulator Javascript -->
    <script src="~/lib/tabulator/tabulator.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Sidebar functionality -->
    <script>
        (function () {
        var root = document.documentElement;
        var sidebar = document.getElementById('adminSidebar');
        var backdrop = document.getElementById('sidebarBackdrop');
        var openBtn = document.getElementById('sidebarOpen');
        var closeBtn = document.getElementById('sidebarClose');
        var collapseBtn = document.getElementById('sidebarToggle');

        function openMenu() {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
        openBtn.setAttribute('aria-expanded', 'true');
        }

        function closeMenu() {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
        openBtn.setAttribute('aria-expanded', 'false');
        }

        if (openBtn) {
        openBtn.addEventListener('click', openMenu);
        }

        if (closeBtn) {
        closeBtn.addEventListener('click', closeMenu);
        }

        if (backdrop) {
        backdrop.addEventListener('click', closeMenu);
        }

        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
        closeMenu();
        }
        });

        if (collapseBtn) {
        collapseBtn.addEventListener('click', function () {
        var collapsed = root.classList.toggle('sidebar-collapsed');

        try {
        localStorage.setItem(
        'adminSidebarCollapsed',
        collapsed ? '1' : '0'
        );
        } catch (e) { }
        });
        }
        })();
    </script>

    <!-- Success notification -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>
            Swal.fire({
            title: @Html.Raw(Json.Serialize(successMsg)),
            icon: "success",
            confirmButtonColor: "#3F72AF"
            });
        </script>
    }

    <!-- Error notification -->
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>
            Swal.fire({
            icon: 'error',
            title: 'Something went wrong',
            text: @Html.Raw(Json.Serialize(errorMsg)),
            confirmButtonColor: "#3F72AF"
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Initialize Lucide after page content and scripts -->
    <script>
        lucide.createIcons();
    </script>

</body>
</html>
