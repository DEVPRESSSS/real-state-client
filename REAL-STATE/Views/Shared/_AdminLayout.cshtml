@using REAL_STATE.Utilities
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var isAdmin = User.IsInRole(RoleSD.Admin);
    var isAgent = User.IsInRole(RoleSD.Agent);
    var dashboardArea = isAdmin ? "Admin" : "AgentAndBroker";

    const string linkBase = "flex items-center gap-3 whitespace-nowrap rounded px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:group-[.sidebar-collapsed]/shell:justify-center lg:group-[.sidebar-collapsed]/shell:px-0";
    const string linkActive = "bg-azure text-white";
    const string linkIdle = "text-navy hover:bg-ice";
    const string iconCls = "size-5 shrink-0";
    const string labelCls = "lg:group-[.sidebar-collapsed]/shell:hidden";

    string NavClass(string controller) =>
        $"{linkBase} " + (string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? linkActive
            : linkIdle);
}

<!DOCTYPE html>
<html lang="en" class="group/shell">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHR</title>
    <script type="importmap"></script>
    <link rel="icon" href="~/Logo.ico" />
    <!-- Tabulator base CSS first, then Tailwind -->
    <link rel="stylesheet" href="~/lib/tabulator/tabulator.min.css" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/REAL_STATE.styles.css" asp-append-version="true" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-snow font-sans text-navy antialiased">

    <!-- Header (73px tall: py-3 + h-12 logo + 1px border) -->
    <header class="sticky top-0 z-30 border-b border-ice bg-white">
        <div class="flex items-center justify-between px-4 py-3 lg:px-6">

            <div class="flex items-center gap-2">

                <!-- Sidebar toggle (mobile) -->
                <button id="sidebarOpen"
                        type="button"
                        class="inline-flex size-10 items-center justify-center rounded text-navy hover:bg-ice 
                        focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:hidden"
                        aria-controls="adminSidebar"
                        aria-expanded="false"
                        aria-label="Open admin menu">
                    <i data-lucide="menu" class="size-6" aria-hidden="true"></i>
                </button>

                <!-- Expand sidebar (desktop, shown only while collapsed) -->
                <button id="sidebarExpand"
                        type="button"
                        class="hidden size-10 items-center justify-center rounded text-navy hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure"
                        aria-controls="adminSidebar"
                        aria-label="Expand sidebar"
                        title="Expand sidebar">
                    <i data-lucide="panel-left-open" class="size-5" aria-hidden="true"></i>
                </button>

                <!-- Brand -->
                <a class="flex shrink-0 items-center rounded"
                   asp-area="@dashboardArea"
                   asp-controller="Dashboard"
                   asp-action="Index">
                   
                    <img class="h-12 w-auto max-w-[220px] object-contain"
                         src="/images/Logo.png"
                         alt="SouthernHomesRealty" />
                </a>
            </div>

            <!-- Sign out -->
            <form method="post"
                  class="m-0"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit"
                        class="inline-flex items-center gap-2 border border-ice bg-white px-3 py-1.5 text-sm font-medium text-navy transition-colors hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    <i data-lucide="log-out" class="size-4" aria-hidden="true"></i>
                    Sign out
                </button>
            </form>
        </div>
    </header>

    <!-- Mobile backdrop -->
    <div id="sidebarBackdrop"
         class="fixed inset-0 z-30 hidden bg-navy/50 lg:hidden"
         aria-hidden="true">
    </div>

    <div class="flex">

        <!-- Sidebar -->
        <aside id="adminSidebar"
               class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col overflow-x-hidden border-r border-ice bg-white transition-all duration-200 lg:sticky lg:top-[73px] lg:z-20 lg:h-[calc(100vh-73px)] lg:w-[250px] lg:shrink-0 lg:translate-x-0 lg:group-[.sidebar-collapsed]/shell:w-[76px]"
               aria-label="Admin sidebar">

            <!-- Mobile sidebar header -->
            <div class="flex items-center justify-between border-b border-ice px-4 py-3 lg:hidden">
                <h2 class="text-base font-medium text-navy">Admin menu</h2>

                <button id="sidebarClose"
                        type="button"
                        class="inline-flex size-9 items-center justify-center rounded text-navy hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure"
                        aria-label="Close admin menu">
                    <i data-lucide="x" class="size-5" aria-hidden="true"></i>
                </button>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto overflow-x-hidden p-3" aria-label="Admin">
                <ul class="flex flex-col gap-1">

                    <!-- Dashboard row + collapse button (shared by Admin and Agent) -->
                    @if (isAdmin || isAgent)
                    {
                        <li class="flex items-center gap-1">
                            <a class="@NavClass("Dashboard") flex-1"
                               asp-area="@dashboardArea"
                               asp-controller="Dashboard"
                               asp-action="Index">
                                <i data-lucide="layout-dashboard" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Dashboard</span>
                            </a>

                            <!-- Collapse (desktop, visible only while expanded) -->
                            <button id="sidebarToggle"
                                    type="button"
                                    class="hidden size-9 shrink-0 items-center justify-center rounded text-navy/70
                                        hover:bg-ice hover:text-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-azure lg:inline-flex"
                                    aria-controls="adminSidebar"
                                    aria-label="Collapse sidebar"
                                    title="Collapse sidebar">
                                <i data-lucide="panel-left-close" class="size-5" aria-hidden="true"></i>
                            </button>
                        </li>
                    }

                    <!-- Admin navigation -->
                    @if (isAdmin)
                    {
                        <li>
                            <a class="@NavClass("Property")"
                               title="Property"
                               asp-area="Admin"
                               asp-controller="Property"
                               asp-action="Index">
                                <i data-lucide="building-2" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Property</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("Developer")"
                               title="Developers"
                               asp-area="Admin"
                               asp-controller="Developer"
                               asp-action="Index">
                                <i data-lucide="building" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Developers</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("Agent")"
                               title="Agents"
                               asp-area="Admin"
                               asp-controller="Agent"
                               asp-action="Index">
                                <i data-lucide="contact-round" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Agents</span>
                            </a>
                        </li>

                        <li>
                            <a class="@NavClass("User")"
                               title="Users"
                               asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index">
                                <i data-lucide="users" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Users</span>
                            </a>
                        </li>
                    }

                    <!-- Agent navigation -->
                    @if (isAgent)
                    {
                        <li>
                            <a class="@NavClass("Listing")"
                               title="My listings"
                               asp-area="AgentAndBroker"
                               asp-controller="Listing"
                               asp-action="Index">
                                <i data-lucide="clipboard-list" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">My Listing</span>
                            </a>
                        </li>
                        <li>
                            <a class="@NavClass("Refferal")"
                               title="My Referrals"
                               asp-area="AgentAndBroker"
                               asp-controller="Refferal"
                               asp-action="Index">
                                <i data-lucide="clipboard-list" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Referrals</span>
                            </a>
                        </li>
                    }

                    <!-- Appointments (Admin sees all, Agent sees their own) -->
                    @if (isAdmin || isAgent)
                    {
                        <li>
                            <a class="@NavClass("Appointment")"
                               title="Appointments"
                               asp-area="Admin"
                               asp-controller="Appointment"
                               asp-action="Index">
                                <i data-lucide="calendar-check" class="@iconCls" aria-hidden="true"></i>
                                <span class="@labelCls">Appointments</span>
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        </aside>

        <!-- Main content -->
        <main role="main" class="min-w-0 flex-1 bg-white p-4 lg:p-6">
            @RenderBody()
        </main>
    </div>

    <!-- JavaScript dependencies -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site-admin.js" asp-append-version="true"></script>
    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Tabulator -->
    <script src="~/lib/tabulator/tabulator.min.js"></script>
    <!-- Lucide: pinned version -->
    <script src="https://unpkg.com/lucide@0.469.0"></script>

    <!-- Sidebar behavior -->
    <script>
        
    </script>

    <!-- Success notification -->
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>
            Swal.fire({
            title: @Html.Raw(Json.Serialize(successMsg)),
            icon: "success",
            confirmButtonColor: "#3F72AF"
            });
        </script>
    }

    <!-- Error notification -->
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>
            Swal.fire({
            icon: 'error',
            title: 'Something went wrong',
            text: @Html.Raw(Json.Serialize(errorMsg)),
            confirmButtonColor: "#3F72AF"
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Initialize Lucide after page content and scripts -->
    <script>
        lucide.createIcons();
    </script>

</body>
</html>