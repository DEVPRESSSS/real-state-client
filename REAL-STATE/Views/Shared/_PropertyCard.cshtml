@using REAL_STATE.Models.DTO.PropertyDTO.REAL_STATE.DTOs
@model FilterPropertyDTO

@{
    var isRent = string.Equals(Model.ListingType, "Rent", StringComparison.OrdinalIgnoreCase);
    var location = string.Join(", ", new[] { Model.City, Model.Province }
        .Where(s => !string.IsNullOrWhiteSpace(s)));
}

<article class="relative flex h-full flex-col overflow-hidden rounded-lg  bg-white border border-ice shadow-sm">


        <img src="@(REAL_STATE.Utilities.HttpUrlAttribute.IsHttpUrl(Model.PrimaryImageUrl) ? Model.PrimaryImageUrl : Url.Content("~/images/condo.jpg"))"
             width="800" height="600" decoding="async"
             alt="@(string.IsNullOrWhiteSpace(Model.PrimaryImageAlt) ? Model.Title : Model.PrimaryImageAlt)"
             class="aspect-[4/3] w-full object-cover"
             loading="lazy" />

    <div class="flex flex-1 flex-col p-4 ">

        <div class="mb-2 flex flex-wrap gap-2">
            <span class="rounded border border-gray-200 bg-ice text-navy px-2 py-0.5
                text-xs font-medium text-gray-700">@Model.PropertyType</span>
            <span class="rounded border border-gray-200 bg-ice text-navy px-2 py-0.5
                text-xs font-medium text-gray-700">For @(isRent ? "rent" : "sale")</span>
        </div>

        <p class="mb-1 text-xl font-medium text-azure">
            ₱@Model.Price.ToString("N0")@(isRent ? " / month" : "")
        </p>

        <h2 class="mb-1 truncate text-base font-medium" title="@Model.Title">@Model.Title</h2>

        @if (!string.IsNullOrWhiteSpace(location))
        {
            <p class="mb-3 truncate text-sm text-gray-500" title="@location">@location</p>
        }

        <ul class="mb-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
            @if (Model.Bedrooms.HasValue)
            {
                <li>@Model.Bedrooms bed</li>
            }
            @if (Model.Bathrooms.HasValue)
            {
                <li>@Model.Bathrooms bath</li>
            }
            @if (Model.FloorAreaSqFt > 0)
            {
                <li>@Model.FloorAreaSqFt.ToString("N0") sq ft</li>
            }
        </ul>

        <a asp-area="" asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id"
           class="mt-auto block rounded-lg border border-navy px-4 py-2 text-center font-medium
                text-navy transition-colors hover:bg-azure
                hover:text-white focus:outline-none focus-visible:ring-2
                focus-visible:ring-green-600 focus-visible:ring-offset-2 after:absolute after:inset-0">
            View details
        </a>
    </div>
</article>
