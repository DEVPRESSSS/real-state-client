@using REAL_STATE.Models.DTO.PropertyDTO.REAL_STATE.DTOs
@model FilterPropertyDTO

@{
    var isRent = string.Equals(Model.ListingType, "Rent", StringComparison.OrdinalIgnoreCase);
    var location = string.Join(", ", new[] { Model.City, Model.Province }
        .Where(s => !string.IsNullOrWhiteSpace(s)));
}

<article class="card h-100 border shadow-sm">
@* 
    @if (string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
    { *@
        <img src="~/images/condo.jpg"
             @* alt="@(string.IsNullOrWhiteSpace(Model.PrimaryImageAlt) ? Model.Title : Model.PrimaryImageAlt)" *@
             class="card-img-top"
             style="aspect-ratio: 4 / 3; object-fit: cover;"
             loading="lazy" />
  @*   }
    else
    {
        <div class="card-img-top bg-secondary-subtle d-flex align-items-center justify-content-center text-secondary small"
             style="aspect-ratio: 4 / 3;">
            No photo available
        </div>
    } *@

    <div class="card-body d-flex flex-column">

        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="badge text-bg-light border">@Model.PropertyType</span>
            <span class="badge text-bg-light border">For @(isRent ? "rent" : "sale")</span>
        </div>

        <p class="h5 text-success mb-1">
            ₱@Model.Price.ToString("N0")@(isRent ? " / month" : "")
        </p>

        <h2 class="h6 mb-1 text-truncate" title="@Model.Title">@Model.Title</h2>

        @if (!string.IsNullOrWhiteSpace(location))
        {
            <p class="text-secondary small mb-3 text-truncate" title="@location">@location</p>
        }

        <ul class="list-unstyled d-flex flex-wrap gap-3 small text-secondary mb-3">
            @if (Model.Bedrooms.HasValue)
            {
                <li>@Model.Bedrooms bed</li>
            }
            @if (Model.Bathrooms.HasValue)
            {
                <li>@Model.Bathrooms bath</li>
            }
            @if (Model.FloorAreaSqFt > 0)
            {
                <li>@Model.FloorAreaSqFt.ToString("N0") sq ft</li>
            }
        </ul>

        @* <a asp-controller="Properties"
           asp-action="Details"
           asp-route-slug="@Model.Slug"
           class="btn btn-outline-success mt-auto stretched-link">
            View details
        </a> *@
        <a asp-area="" asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline-success w-100">View Details</a>
    </div>
</article>