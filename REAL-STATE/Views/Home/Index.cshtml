@using REAL_STATE.Models.DTO.PropertyDTO.REAL_STATE.DTOs
@model REAL_STATE.Models.VM.PagedResult<FilterPropertyDTO>

@{
    var listingType = Context.Request.Query["listingType"].ToString();
    var isRent = string.Equals(listingType, "Rent", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = isRent ? "Properties for rent" : "Properties for sale";

    string Q(string key) => Context.Request.Query[key].ToString();

    var hasFilters = new[] { "city", "propertyType", "minPrice", "maxPrice", "minFloorArea" }
        .Any(k => !string.IsNullOrWhiteSpace(Q(k)));
}

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="mb-2 text-navy text-3xl font-semibold tracking-tight  sm:text-4xl">
            @ViewData["Title"]
        </h1>
        <p class="text-sm text-gray-500 sm:text-base">
            Browse listings from developers, agents and brokers.
        </p>
    </div>

    <!-- Mobile Filter Toggle -->
    <div class="mb-4 lg:hidden">
        <button type="button"
                id="filterToggle"
                aria-expanded="@(hasFilters ? "true" : "false")"
                aria-controls="filterPanel"
                class="flex w-full items-center justify-center gap-2
                rounded-lg border border-navy px-4 py-3 text-sm
                font-semibold text-emerald-700 transition hover:bg-emerald-50">
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="h-5 w-5"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 4h18M6 10h12m-9 6h6m-3 4v-4" />
            </svg>
            Search and filter
        </button>
    </div>

    <!-- Filter Panel -->
    <div id="filterPanel" class="@(hasFilters ? "" : "hidden") mb-8 lg:block">
        <form method="get"
              asp-controller="Home"
              asp-action="Index"
              class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm sm:p-6">

            <input type="hidden"
                   name="listingType"
                   value="@(isRent ? "Rent" : "Sale")" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12">

                <!-- Location -->
                <div class="lg:col-span-3">
                    <label for="city" class="mb-2 block text-sm font-medium text-gray-700">
                        Location
                    </label>
                    <input id="city"
                           name="city"
                           type="text"
                           placeholder="City"
                           value="@Q("city")"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                </div>

                <!-- Property Type -->
                <div class="lg:col-span-3">
                    <label for="propertyType" class="mb-2 block text-sm font-medium text-gray-700">
                        Property type
                    </label>
                    <input id="propertyType"
                           name="propertyType"
                           type="text"
                           placeholder="e.g. Condominium"
                           value="@Q("propertyType")"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                </div>

                <!-- Minimum Price -->
                <div class="sm:col-span-1 lg:col-span-2">
                    <label for="minPrice" class="mb-2 block text-sm font-medium text-gray-700">
                        Min price (₱)
                    </label>
                    <input id="minPrice"
                           name="minPrice"
                           type="number"
                           min="0"
                           step="any"
                           value="@Q("minPrice")"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                </div>

                <!-- Maximum Price -->
                <div class="sm:col-span-1 lg:col-span-2">
                    <label for="maxPrice" class="mb-2 block text-sm font-medium text-gray-700">
                        Max price (₱)
                    </label>
                    <input id="maxPrice"
                           name="maxPrice"
                           type="number"
                           min="0"
                           step="any"
                           value="@Q("maxPrice")"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                </div>

                <!-- Minimum Floor Area -->
                <div class="sm:col-span-2 lg:col-span-2">
                    <label for="minFloorArea" class="mb-2 block text-sm font-medium text-gray-700">
                        Min floor area (sq ft)
                    </label>
                    <input id="minFloorArea"
                           name="minFloorArea"
                           type="number"
                           min="0"
                           step="any"
                           value="@Q("minFloorArea")"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 outline-none transition focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100" />
                </div>

            </div>

            <!-- Filter Actions -->
            <div class="mt-5 flex flex-wrap items-center gap-3">
                <button type="submit"
                        class="rounded-lg bg-azure text-white hover:bg-azure-dark active:bg-azure-darker px-5 py-2.5 text-sm font-semibold text-white transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
                    Search properties
                </button>

                @if (hasFilters)
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-listingType="@(isRent ? "Rent" : "Sale")"
                       class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-600 transition hover:bg-gray-50 hover:text-gray-900">
                        Reset filters
                    </a>
                }
            </div>

        </form>
    </div>

    <partial name="_Pagination" model="Model" />
    <!-- Property Listings -->
    @if (Model != null && Model.Items.Any())
    {
        <div class="mb-5 flex items-center justify-between">
            <p class="text-sm text-gray-500" aria-live="polite">
                Showing
                <span class="font-semibold text-gray-900">@Model.Items.Count()</span>
                @(Model.Items.Count() == 1 ? "property" : "properties")
            </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var property in Model.Items)
            {
                <div>
                    <partial name="_PropertyCard" model="property" />
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-gray-200 bg-white px-6 py-16 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-7 w-7 text-gray-400"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 10.5 12 3l9 7.5M5.25 9v11.25h13.5V9M9 20.25v-6h6v6" />
                </svg>
            </div>

            <h2 class="mb-2 text-lg font-semibold text-gray-900">
                No properties found
            </h2>
            <p class="text-sm text-gray-500">
                Try changing your location, price range, or property type.
            </p>
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("filterToggle");
            const panel = document.getElementById("filterPanel");

            if (!toggle || !panel) return;

            toggle.addEventListener("click", function () {
                const isHidden = panel.classList.toggle("hidden");
                toggle.setAttribute("aria-expanded", (!isHidden).toString());
            });
        });
    </script>
}
