@using REAL_STATE.Models.VM
@model PropertyDetailsVM
@{
    var p = Model.Property;
    var a = Model.Agent;
    ViewData["Title"] = p.Title;

    var location = string.Join(", ", new[] { p.Address, p.City, p.Province, p.Country }
        .Where(x => !string.IsNullOrWhiteSpace(x)));

    var isAvailable = string.Equals(p.Status, "Available", StringComparison.OrdinalIgnoreCase);
    var isRent = p.ListingType == "Rent";

    const string h2 = "mb-4 font-display text-lg font-semibold text-navy";
    const string badge = "inline-flex items-center gap-1 rounded bg-ice px-2 py-0.5 text-xs font-medium text-navy";
    const string badgeOutline = "inline-flex items-center gap-1 rounded border border-azure bg-white px-2 py-0.5 text-xs font-medium text-azure";
    const string badgeSolid = "inline-flex items-center gap-1 rounded bg-azure px-2 py-0.5 text-xs font-medium text-white";
    const string btnPrimary = "inline-flex w-full items-center justify-center gap-2 bg-azure px-4 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
    const string btnOutline = "inline-flex w-full items-center justify-center gap-2 border border-azure px-4 py-3 font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2";
    const string link = "text-azure hover:text-azure-dark hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-azure";
}

<div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">

    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-navy/60">
            <li>
                <a class="@link" asp-controller="Home" asp-action="Property" asp-route-listingType="@p.ListingType">
                    Properties for @(isRent ? "rent" : "sale")
                </a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-navy" aria-current="page">@p.Title</li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <!-- Property information: one parent card -->
        <div class="lg:col-span-2">
            <div class="divide-y divide-ice rounded-lg border border-ice bg-white shadow-sm">

                <!-- Header: badges, title, location, price -->
                <header class="p-6">
                    <div class="mb-3 flex flex-wrap gap-2">
                        <span class="@(isRent ? badgeOutline : badge)">For @(isRent ? "rent" : "sale")</span>
                        <span class="@badge">@p.PropertyType</span>
                        <span class="@(isAvailable ? badgeSolid : badge)">@p.Status</span>
                        @if (p.IsFeatured)
                        {
                            <span class="@badgeOutline"><i data-lucide="star" class="size-3" aria-hidden="true"></i>Featured</span>
                        }
                    </div>

                    <h1 class="mb-2 font-display text-3xl font-semibold text-navy md:text-4xl">@p.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(location))
                    {
                        <p class="mb-4 flex items-start gap-2 text-navy/60">
                            <i data-lucide="map-pin" class="mt-0.5 size-4 shrink-0" aria-hidden="true"></i>@location
                        </p>
                    }

                    <p class="text-3xl font-semibold text-azure">
                        ₱@p.Price.ToString("N2")@(isRent ? " / month" : "")
                    </p>
                </header>

                <!-- Key facts -->
                <section class="p-6" aria-label="Key facts">
                    <dl class="grid grid-cols-2 gap-6 text-center md:grid-cols-4">
                        <div>
                            <i data-lucide="bed-double" class="mx-auto mb-2 size-6 text-azure" aria-hidden="true"></i>
                            <dd class="font-semibold text-navy">@(p.Bedrooms?.ToString() ?? "-")</dd>
                            <dt class="text-sm text-navy/60">Bedrooms</dt>
                        </div>
                        <div>
                            <i data-lucide="bath" class="mx-auto mb-2 size-6 text-azure" aria-hidden="true"></i>
                            <dd class="font-semibold text-navy">@(p.Bathrooms?.ToString() ?? "-")</dd>
                            <dt class="text-sm text-navy/60">Bathrooms</dt>
                        </div>
                        <div>
                            <i data-lucide="maximize" class="mx-auto mb-2 size-6 text-azure" aria-hidden="true"></i>
                            <dd class="font-semibold text-navy">@p.FloorAreaSqFt.ToString("N0") sq ft</dd>
                            <dt class="text-sm text-navy/60">Floor area</dt>
                        </div>
                        <div>
                            <i data-lucide="house" class="mx-auto mb-2 size-6 text-azure" aria-hidden="true"></i>
                            <dd class="font-semibold text-navy">@p.PropertyType</dd>
                            <dt class="text-sm text-navy/60">Type</dt>
                        </div>
                    </dl>
                </section>

                <!-- Description -->
                <section class="p-6" aria-labelledby="about-heading">
                    <h2 id="about-heading" class="@h2">About this property</h2>
                    @if (!string.IsNullOrWhiteSpace(p.Description))
                    {
                        <p class="whitespace-pre-line text-navy">@p.Description</p>
                    }
                    else
                    {
                        <p class="text-navy/60">No description provided.</p>
                    }
                </section>

                <!-- Details -->
                <section class="p-6" aria-labelledby="details-heading">
                    <h2 id="details-heading" class="@h2">Property details</h2>
                    <dl class="divide-y divide-ice text-sm">
                        @foreach (var row in new (string Label, string Value)[]
                        {
                            ("Listing type", p.ListingType),
                            ("Status", p.Status),
                            ("Address", string.IsNullOrWhiteSpace(p.Address) ? "-" : p.Address),
                            ("City", p.City),
                            ("Province", string.IsNullOrWhiteSpace(p.Province) ? "-" : p.Province),
                            ("Country", p.Country),
                            ("Listed on", p.CreatedAt.ToString("MMMM dd, yyyy"))
                        })
                        {
                            <div class="grid grid-cols-3 gap-4 py-3">
                                <dt class="text-navy/60">@row.Label</dt>
                                <dd class="col-span-2 text-navy">@row.Value</dd>
                            </div>
                        }
                    </dl>
                </section>
            </div>
        </div>

        <!-- Sidebar: one parent card -->
        <div>
            <div class="divide-y divide-ice rounded-lg border border-ice bg-white shadow-sm lg:sticky lg:top-24">

                <!-- Schedule a viewing -->
                <section class="p-6" aria-labelledby="interest-heading">
                    <h2 id="interest-heading" class="mb-2 font-display text-lg font-semibold text-navy">Interested in this property?</h2>

                    @if (isAvailable)
                    {
                        <p class="mb-4 text-sm text-navy/60">Send a viewing request with your preferred date and time.</p>
                        <a class="@btnPrimary"
                           asp-area="Client" asp-controller="Appointment" asp-action="Create"
                           asp-route-propertyId="@p.Id">
                            <i data-lucide="calendar-check" class="size-4" aria-hidden="true"></i>Schedule a viewing
                        </a>
                    }
                    else
                    {
                        <p class="text-sm text-navy/60">
                            This property is currently @p.Status.ToLowerInvariant() and is not accepting viewing requests.
                        </p>
                    }
                </section>

                <!-- Listed by -->
                <section class="p-6" aria-labelledby="agent-heading">
                    <h2 id="agent-heading" class="@h2">Listed by</h2>

                    @if (a != null)
                    {
                        <div class="mb-4 flex items-center gap-4">
                            @if (!string.IsNullOrWhiteSpace(a.PhotoUrl))
                            {
                                <img src="@a.PhotoUrl" alt="@a.FullName" loading="lazy"
                                     class="size-16 shrink-0 rounded-full border border-ice object-cover" />
                            }
                            else
                            {
                                <span class="inline-flex size-16 shrink-0 items-center justify-center rounded-full bg-ice text-azure" aria-hidden="true">
                                    <i data-lucide="user-round" class="size-7"></i>
                                </span>
                            }
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-navy">@a.FullName</p>
                                <p class="text-sm text-navy/60">@a.Role</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(a.Bio))
                        {
                            <p class="mb-4 text-sm text-navy/60">@a.Bio</p>
                        }

                        <ul class="mb-4 space-y-2 text-sm text-navy">
                            @if (!string.IsNullOrWhiteSpace(a.LicenseNumber))
                            {
                                <li class="flex items-center gap-2">
                                    <i data-lucide="id-card" class="size-4 shrink-0 text-navy/60" aria-hidden="true"></i>License: @a.LicenseNumber
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.Phone))
                            {
                                <li class="flex items-center gap-2">
                                    <i data-lucide="phone" class="size-4 shrink-0 text-navy/60" aria-hidden="true"></i>
                                    <a href="tel:@a.Phone" class="@link">@a.Phone</a>
                                </li>
                            }
                            <li class="flex items-center gap-2">
                                <i data-lucide="mail" class="size-4 shrink-0 text-navy/60" aria-hidden="true"></i>
                                <a href="mailto:@a.Email" class="break-all @link">@a.Email</a>
                            </li>
                        </ul>

                        <div class="grid gap-2">
                            <a class="@btnOutline"
                               href="mailto:@a.Email?subject=@Uri.EscapeDataString("Inquiry about " + p.Title)">
                                <i data-lucide="mail" class="size-4" aria-hidden="true"></i>Contact agent
                            </a>
                            @if (!string.IsNullOrWhiteSpace(a.Phone))
                            {
                                <a class="@btnOutline" href="tel:@a.Phone">
                                    <i data-lucide="phone" class="size-4" aria-hidden="true"></i>Call
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-navy/60">This listing is handled directly by the developer.</p>
                    }
                </section>

                @if (p.Developer != null)
                {
                    <section class="p-6" aria-labelledby="dev-heading">
                        <h2 id="dev-heading" class="@h2">Developer</h2>
                        <div class="flex items-center gap-4">
                            @if (!string.IsNullOrWhiteSpace(p.Developer.LogoUrl))
                            {
                                <img src="@p.Developer.LogoUrl" alt="@p.Developer.Name" loading="lazy"
                                     class="size-14 shrink-0 rounded border border-ice bg-white object-contain p-1" />
                            }
                            else
                            {
                                <span class="inline-flex size-14 shrink-0 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                                    <i data-lucide="building-2" class="size-6"></i>
                                </span>
                            }
                            <div class="min-w-0">
                                <p class="break-words font-semibold text-navy">@p.Developer.Name</p>
                                @if (!string.IsNullOrWhiteSpace(p.Developer.WebsiteUrl))
                                {
                                    <a href="@p.Developer.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1 text-sm @link">
                                        Visit website <i data-lucide="external-link" class="size-3.5" aria-hidden="true"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    <div class="mt-8">
        <a asp-controller="Home" asp-action="Property" asp-route-listingType="@p.ListingType"
           class="inline-flex items-center gap-2 border border-ice bg-white px-4 py-2 font-medium text-navy transition-colors hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
            <i data-lucide="arrow-left" class="size-4" aria-hidden="true"></i>Back to listings
        </a>
    </div>
</div>