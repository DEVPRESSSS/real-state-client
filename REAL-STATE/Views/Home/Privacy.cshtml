@{
    ViewData["Title"] = "About us";
}

<!-- PAGE HEADER -->
<section class="border-b border-ice bg-white py-12 lg:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-azure">About us</p>
        <h1 class="mb-4 max-w-3xl font-display text-4xl font-semibold text-navy md:text-5xl">
            One place to find, compare and connect
        </h1>
        <p class="max-w-2xl text-lg text-navy/60">
            Realty brings property listings from different developers, agents and brokers together,
            so finding a home doesn't mean visiting a dozen websites.
        </p>
    </div>
</section>

<!-- MISSION -->
<section class="py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2">

            <div>
                <h2 class="mb-4 font-display text-3xl font-semibold text-navy md:text-4xl">Our mission</h2>
                <p class="mb-4 text-navy/70">
                    Searching for a property can be scattered and confusing. Listings live on separate sites,
                    details are hard to compare, and it isn't always clear who to talk to.
                </p>
                <p class="text-navy/70">
                    We built this platform to put everything in one clear, easy-to-use place: honest listing
                    information, simple search tools, and direct contact with the people who can help.
                </p>
            </div>

            <div class="rounded-lg border border-ice bg-white p-6 shadow-sm md:p-8">
                <h3 class="mb-4 text-lg font-medium text-navy">What you can do here</h3>
                <ul class="space-y-3 text-navy">
                    <li class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Browse properties for sale and for rent
                    </li>
                    <li class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Filter by location, type, price and floor area
                    </li>
                    <li class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Save favorites and come back to them later
                    </li>
                    <li class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-5 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Reach out to agents and brokers directly
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- WHO IS ON THE PLATFORM -->
<section class="bg-white py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="mb-3 font-display text-3xl font-semibold text-navy md:text-4xl">Who's on the platform</h2>
            <p class="text-navy/60">Three groups, one shared goal: matching people with the right property.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M15 9h3a1 1 0 0 1 1 1v11M9 8h2M9 12h2M9 16h2" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Developers</h3>
                <p class="text-sm text-navy/60">Developers list their projects so buyers and renters can discover them alongside other options.</p>
            </article>

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Agents and brokers</h3>
                <p class="text-sm text-navy/60">Advisors have a public profile and answer questions about the listings they handle.</p>
            </article>

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-7h6v7" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Buyers and renters</h3>
                <p class="text-sm text-navy/60">Clients search, save and compare properties, then get in touch when something fits.</p>
            </article>
        </div>
    </div>
</section>

<!-- VALUES -->
<section class="py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="mb-3 font-display text-3xl font-semibold text-navy md:text-4xl">What we stand for</h2>
            <p class="text-navy/60">The principles behind how the platform is built and run.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <article class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <h3 class="mb-2 text-lg font-medium text-navy">Clear information</h3>
                <p class="text-sm text-navy/60">Price, size, location and photos are shown plainly, with nothing hidden or exaggerated.</p>
            </article>
            <article class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <h3 class="mb-2 text-lg font-medium text-navy">Reviewed advisors</h3>
                <p class="text-sm text-navy/60">Every agent and broker application is reviewed by an admin before joining the platform.</p>
            </article>
            <article class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <h3 class="mb-2 text-lg font-medium text-navy">Easy to use</h3>
                <p class="text-sm text-navy/60">Simple search and filters that work the same on a phone, tablet or computer.</p>
            </article>
            <article class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <h3 class="mb-2 text-lg font-medium text-navy">Respect for your data</h3>
                <p class="text-sm text-navy/60">Your account details are used to run your account and handle your inquiries.</p>
            </article>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="bg-navy py-16 text-white">
    <div class="mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-3 font-display text-3xl font-semibold md:text-4xl">Join us</h2>
        <p class="mx-auto mb-8 max-w-xl text-white/75">
            Create an account to start saving properties, or apply to join as an agent or broker.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
            <a href="/Identity/Account/Register"
               class="inline-flex items-center justify-center bg-azure px-6 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2 focus-visible:ring-offset-navy">
                Create an account
            </a>
            <a href="/Home/Register"
               class="inline-flex items-center justify-center border border-white/70 px-6 py-3 font-medium text-white transition-colors hover:bg-white hover:text-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy">
                Apply as an advisor
            </a>
        </div>
    </div>
</section>