@using REAL_STATE.Models.VM
@model PagedAgentsVM
@{
    ViewData["Title"] = "Our advisors";

    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);
}

<section class="bg-white border-bottom py-5">
    <div class="container-xxl">
        <h1 class="display-3 fw-semibold text-primary-emphasis mb-3" style="font-family:'Playfair Display',serif;">
            Meet our advisors
        </h1>
        <p class="text-secondary mb-0">
            Local expertise, honest guidance, and relationships built for the long term.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container-xxl">

        @if (Model.Agents.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
                @foreach (var a in Model.Agents)
                {
                    <div class="col">
                        <article class="card h-100 border-0 rounded-0 shadow-sm">

                            <div class="ratio" style="--bs-aspect-ratio:110%;">
                                @if (!string.IsNullOrWhiteSpace(a.PhotoUrl))
                                {
                                    <img src="@a.PhotoUrl" alt="@a.FullName" loading="lazy"
                                         class="object-fit-cover w-100 h-100" style="object-position:top;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center text-primary">
                                        <i class="bi bi-person-fill display-1"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    @if (a.IsVerified)
                                    {
                                        <span class="badge text-bg-primary text-uppercase">
                                            <i class="bi bi-patch-check-fill me-1"></i>Verified advisor
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-success text-uppercase">Advisor</span>
                                    }
                                </div>

                                <h2 class="h5 fw-medium text-primary-emphasis mb-1" style="font-family:'Playfair Display',serif;">
                                    @a.FullName
                                </h2>
                                <div class="small text-secondary mb-3">@a.Role</div>

                                <ul class="list-group list-group-flush small mb-3">
                                    <li class="list-group-item d-flex justify-content-between gap-2 px-0">
                                        <span class="text-secondary">Area</span>
                                        <span class="text-end">@a.Area</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between gap-2 px-0">
                                        <span class="text-secondary">Listings</span>
                                        <span class="text-end">@a.ActiveListings active</span>
                                    </li>
                                </ul>

                                @if (!string.IsNullOrWhiteSpace(a.Email))
                                {
                                    <a class="btn btn-primary rounded-0 mt-auto"
                                       href="mailto:@a.Email?subject=Inquiry for @a.FullName">
                                        Contact advisor <i class="bi bi-arrow-up-right ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary rounded-0 mt-auto" disabled>
                                        Contact advisor
                                    </button>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5" aria-label="Advisors pagination">
                    <ul class="pagination justify-content-center mb-2">
                        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-controller="Agents" asp-action="Index"
                               asp-route-page="@(Model.Page - 1)" aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @if (start > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Agents" asp-action="Index" asp-route-page="1">1</a>
                            </li>
                            @if (start > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                        }

                        @for (var i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" asp-controller="Agents" asp-action="Index"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }

                        @if (end < Model.TotalPages)
                        {
                            @if (end < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-controller="Agents" asp-action="Index"
                                   asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-controller="Agents" asp-action="Index"
                               asp-route-page="@(Model.Page + 1)" aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>

                    <p class="text-center small text-secondary mb-0">
                        Showing @(((Model.Page - 1) * Model.PageSize) + 1)&ndash;@(Math.Min(Model.Page * Model.PageSize, Model.TotalItems))
                        of @Model.TotalItems advisors
                    </p>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-people display-4"></i>
                <p class="mt-2 mb-0">No advisors available yet.</p>
            </div>
        }
    </div>
</section>