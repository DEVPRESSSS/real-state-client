@using REAL_STATE.Models.VM
@model REAL_STATE.Models.VM.PagedResult<DeveloperCardVM>
<partial name="_Pagination" model="Model" />
@{
    ViewData["Title"] = "Developers";
}

<section class="py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <h1 class="mb-3 font-display  font-semibold text-navy md:text-4xl">
            Our developers
        </h1>
        <p class="text-navy/60">Trusted developers behind the projects listed on our platform.</p>
    </div>
</section>

<section >
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

        @if (Model != null && Model.Items.Any())
        {
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var d in Model.Items)
                {
                    <article class="flex h-full flex-col rounded-lg border border-ice bg-white p-4 shadow-sm">

                        <div class="mb-4 flex items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(d.LogoUrl))
                            {
                                <img src="@d.LogoUrl" alt="@d.Name" loading="lazy"
                                     class="size-16 shrink-0 rounded border border-ice bg-white object-contain p-1" />
                            }
                            else
                            {
                                <span class="inline-flex size-16 shrink-0 items-center justify-center rounded bg-ice text-azure"
                                      aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-8" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M3 21h18M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M15 9h3a1 1 0 0 1 1 1v11M9 8h2M9 12h2M9 16h2" />
                                    </svg>
                                </span>
                            }
                            <h2 class="min-w-0 break-words font-display text-xl font-medium text-navy">
                                @d.Name
                            </h2>
                        </div>

                        <p class="text-sm text-navy/60">
                            @(string.IsNullOrWhiteSpace(d.Description) ? "No description provided." : d.Description)
                        </p>

                        <div class="mb-4 mt-auto flex justify-between border-t border-ice pt-4 text-sm">
                            <span class="text-navy/60">Listings</span>
                            <span class="text-navy">@d.AvailableListings available</span>
                        </div>

                        @if (REAL_STATE.Utilities.HttpUrlAttribute.IsHttpUrl(d.WebsiteUrl))
                        {
                            <a href="@d.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center justify-center gap-1 bg-azure px-4 py-2 text-center font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                                Visit website
                                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" />
                                </svg>
                            </a>
                        }
                        else
                        {
                            <button type="button" disabled
                                    class="cursor-not-allowed bg-ice px-4 py-2 font-medium text-navy/50">
                                No website
                            </button>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="py-12 text-center text-navy/60">
                <p>No developers available yet.</p>
            </div>
        }
    </div>
</section>
