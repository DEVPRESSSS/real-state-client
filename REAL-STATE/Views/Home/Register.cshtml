@using REAL_STATE.Models.VM
@model AgentRegisterVM
@{
    ViewData["Title"] = "Become an advisor";

    const string inputCls = "block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30";
    const string labelCls = "mb-1 block text-sm font-medium text-navy";
    const string errCls = "mt-1 block text-sm text-red-700";
}

<div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-3xl">

        <div class="mb-6">
            <h1 class="mb-1 font-display text-3xl font-semibold text-navy md:text-4xl">Become an advisor</h1>
            <p class="text-navy/60">Create your account and profile. An admin reviews every application.</p>
        </div>

        <form asp-controller="Home" asp-action="Register" method="post" novalidate
              class="rounded-lg border border-ice bg-white p-6 shadow-sm md:p-8">

            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700" role="alert"></div>

            <h2 class="mb-4 text-lg font-medium text-navy">Your details</h2>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label asp-for="FullName" class="@labelCls"></label>
                    <input asp-for="FullName" class="@inputCls" autocomplete="name" />
                    <span asp-validation-for="FullName" class="@errCls"></span>
                </div>

                <div>
                    <label asp-for="Email" class="@labelCls"></label>
                    <input asp-for="Email" type="email" class="@inputCls" autocomplete="email" />
                    <span asp-validation-for="Email" class="@errCls"></span>
                </div>

                <div>
                    <label asp-for="Phone" class="@labelCls"></label>
                    <input asp-for="Phone" type="tel" class="@inputCls" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="@errCls"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="LicenseNumber" class="@labelCls"></label>
                    <input asp-for="LicenseNumber" class="@inputCls" />
                    <span asp-validation-for="LicenseNumber" class="@errCls"></span>
                </div>

                <div class="md:col-span-2">
                    <label asp-for="Bio" class="@labelCls"></label>
                    <textarea asp-for="Bio" class="@inputCls" rows="4"></textarea>
                    <span asp-validation-for="Bio" class="@errCls"></span>
                </div>
            </div>

            <hr class="my-6 border-ice" />

            <h2 class="mb-4 text-lg font-medium text-navy">Password</h2>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div>
                    <label asp-for="Password" class="@labelCls"></label>
                    <input asp-for="Password" type="password" class="@inputCls" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="@errCls"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="@labelCls"></label>
                    <input asp-for="ConfirmPassword" type="password" class="@inputCls" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="@errCls"></span>
                </div>
            </div>

            <button type="submit"
                    class="mt-8 w-full bg-azure px-4 py-3 text-lg font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                Submit application
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}