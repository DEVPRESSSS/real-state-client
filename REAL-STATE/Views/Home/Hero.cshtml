@{
    ViewData["Title"] = "Find your next home";
}

<!-- HERO -->
<section class="bg-navy text-white">
    <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="max-w-3xl">
            <h1 class="mb-4 font-display text-4xl font-semibold leading-tight md:text-6xl">
                Find a place that fits your life
            </h1>
            <p class="mb-8 text-lg text-white/75">
                Browse listings from developers, agents and brokers in one place.
                Save the ones you like and get in touch when you're ready.
            </p>
        </div>

        <form method="get" action="/Home/Property"
              class="max-w-4xl rounded-lg bg-white p-4 text-navy shadow-sm md:p-6">
            <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-12">
                <div class="md:col-span-3">
                    <label for="heroListing" class="mb-1 block text-sm font-medium text-navy">I want to</label>
                    <select id="heroListing" name="listingType"
                            class="block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30">
                        <option value="Sale">Buy</option>
                        <option value="Rent">Rent</option>
                    </select>
                </div>
                <div class="md:col-span-6">
                    <label for="heroCity" class="mb-1 block text-sm font-medium text-navy">Location</label>
                    <input id="heroCity" name="city" type="text" placeholder="City"
                           class="block w-full rounded border border-ice bg-white px-3 py-2.5 text-navy placeholder:text-navy/40 focus:border-azure focus:outline-none focus:ring-2 focus:ring-azure/30" />
                </div>
                <div class="md:col-span-3">
                    <button type="submit"
                            class="w-full bg-azure px-6 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                        Search properties
                    </button>
                </div>
            </div>
        </form>

        <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/Identity/Account/Register"
               class="inline-flex items-center justify-center bg-azure px-6 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                Create a free account
            </a>
            <a href="/Home/Register"
               class="inline-flex items-center justify-center border border-white/70 px-6 py-3 font-medium text-white transition-colors hover:bg-white hover:text-navy focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy">
                I'm an agent or broker
            </a>
        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="bg-white py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="mb-3 font-display text-3xl font-semibold text-navy md:text-4xl">Why choose us</h2>
            <p class="text-navy/60">Everything you need to search, compare and connect, without jumping between websites.</p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16M15 9h3a1 1 0 0 1 1 1v11M9 8h2M9 12h2M9 16h2" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Many developers, one place</h3>
                <p class="text-sm text-navy/60">Compare listings from different developers side by side.</p>
            </article>

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Search that fits you</h3>
                <p class="text-sm text-navy/60">Filter by location, type, price and floor area.</p>
            </article>

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7a2 2 0 0 0-2 2v16l7-4 7 4V5a2 2 0 0 0-2-2Z" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Save your favorites</h3>
                <p class="text-sm text-navy/60">Bookmark properties and revisit them any time.</p>
            </article>

            <article class="rounded-lg border border-ice bg-snow p-6">
                <span class="mb-4 inline-flex size-12 items-center justify-center rounded bg-ice text-azure" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6.75a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a7.5 7.5 0 0 1 15 0" /></svg>
                </span>
                <h3 class="mb-2 text-lg font-medium text-navy">Reviewed advisors</h3>
                <p class="text-sm text-navy/60">Every agent and broker application is reviewed by an admin.</p>
            </article>
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="mb-3 font-display text-3xl font-semibold text-navy md:text-4xl">How it works</h2>
            <p class="text-navy/60">Three steps from searching to talking with an advisor.</p>
        </div>

        <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <li class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <span class="mb-4 inline-flex size-10 items-center justify-center rounded-full bg-azure font-semibold text-white">1</span>
                <h3 class="mb-2 text-lg font-medium text-navy">Create your account</h3>
                <p class="text-sm text-navy/60">Register with your email to save properties and send inquiries.</p>
            </li>
            <li class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <span class="mb-4 inline-flex size-10 items-center justify-center rounded-full bg-azure font-semibold text-white">2</span>
                <h3 class="mb-2 text-lg font-medium text-navy">Search and compare</h3>
                <p class="text-sm text-navy/60">Narrow down listings and review photos, price and details.</p>
            </li>
            <li class="rounded-lg border border-ice bg-white p-6 shadow-sm">
                <span class="mb-4 inline-flex size-10 items-center justify-center rounded-full bg-azure font-semibold text-white">3</span>
                <h3 class="mb-2 text-lg font-medium text-navy">Get in touch</h3>
                <p class="text-sm text-navy/60">Send an inquiry when you find a match.</p>
            </li>
        </ol>
    </div>
</section>

<!-- TWO AUDIENCES -->
<section class="bg-white py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">

            <article class="flex flex-col rounded-lg border border-ice bg-white p-8 shadow-sm">
                <h2 class="mb-3 font-display text-2xl font-semibold text-navy md:text-3xl">Looking to buy or rent?</h2>
                <p class="mb-6 text-navy/60">Create an account to save properties and send inquiries.</p>
                <ul class="mb-8 space-y-2 text-sm text-navy">
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Browse listings for sale and for rent
                    </li>
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Save favorites to your account
                    </li>
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Contact advisors directly from a listing
                    </li>
                </ul>
                <a href="/Identity/Account/Register"
                   class="mt-auto inline-flex items-center justify-center bg-azure px-6 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                    Register as a client
                </a>
            </article>

            <article class="flex flex-col rounded-lg bg-navy p-8 text-white shadow-sm">
                <h2 class="mb-3 font-display text-2xl font-semibold md:text-3xl">Are you an agent or broker?</h2>
                <p class="mb-6 text-white/75">Apply to join and put your profile and listings in front of people who are searching.</p>
                <ul class="mb-8 space-y-2 text-sm">
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-ice" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Get a public advisor profile
                    </li>
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-ice" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Receive inquiries on your listings
                    </li>
                    <li class="flex items-start gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 size-4 shrink-0 text-ice" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" /></svg>
                        Applications are reviewed by an admin
                    </li>
                </ul>
                <a href="/Home/Register"
                   class="mt-auto inline-flex items-center justify-center bg-white px-6 py-3 font-medium text-navy transition-colors hover:bg-ice focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-navy">
                    Apply as an advisor
                </a>
            </article>
        </div>
    </div>
</section>

<!-- FINAL CTA -->
<section class="border-t border-ice py-16">
    <div class="mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-3 font-display text-3xl font-semibold text-navy md:text-4xl">Ready to get started?</h2>
        <p class="mx-auto mb-8 max-w-xl text-navy/60">Browse the latest listings now, or create an account to save and inquire.</p>
        <div class="flex flex-wrap justify-center gap-3">
            <a href="/Home/Property"
               class="inline-flex items-center justify-center bg-azure px-6 py-3 font-medium text-white transition-colors hover:bg-azure-dark active:bg-azure-darker focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                Browse properties
            </a>
            <a href="/Identity/Account/Register"
               class="inline-flex items-center justify-center border border-azure px-6 py-3 font-medium text-azure transition-colors hover:bg-azure hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-azure focus-visible:ring-offset-2">
                Create an account
            </a>
        </div>
    </div>
</section>